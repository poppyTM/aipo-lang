{
  "ai": {
    "preferred_models": [
      {
        "model": "glm-5.3-flash",
        "provider": "z-ai"
      }
    ]
  },
  "context": {
    "architecture": "progressive-context-architecture",
    "budget_profile": "medium",
    "deep_recursion": {
      "enabled": false,
      "experimental": true
    },
    "methodology": "lean-progressive-context",
    "mode": "progressive",
    "profiles": {
      "large": {
        "context_hard_tokens": 32000,
        "context_target_tokens": 16000,
        "max_delegation_depth": 1,
        "max_expansion_rounds": 3,
        "output_hard_tokens": 6000,
        "output_target_tokens": 3000
      },
      "medium": {
        "context_hard_tokens": 16000,
        "context_target_tokens": 8000,
        "max_delegation_depth": 1,
        "max_expansion_rounds": 2,
        "output_hard_tokens": 3000,
        "output_target_tokens": 1500
      },
      "small": {
        "context_hard_tokens": 6000,
        "context_target_tokens": 3000,
        "max_delegation_depth": 0,
        "max_expansion_rounds": 1,
        "output_hard_tokens": 1000,
        "output_target_tokens": 500
      }
    },
    "runtime": {
      "completed_context_ttl": "0d",
      "database": ".prumo/runtime/prumo.db",
      "failed_context_ttl": "7d"
    }
  },
  "documentation": {
    "audiences": [
      "user",
      "developer",
      "operations",
      "agent"
    ],
    "canonical_format": "markdown",
    "entrypoint": "docs/PRUMO.md",
    "site": {
      "enabled": true,
      "generated": true,
      "public_internal_views": true,
      "source": "docs"
    },
    "virtual_chunking": true
  },
  "features": [
    "compiler-frontend",
    "core-ir",
    "bytecode-vm",
    "diagnostics",
    "formatter",
    "cli",
    "stdlib"
  ],
  "framework": {
    "name": "prumo",
    "version": "0.6.0"
  },
  "goals": {
    "active_goal": null,
    "active_phase": "P07"
  },
  "intelligence": {
    "distinguish_observed_estimated": true,
    "enabled": true,
    "path": ".prumo/history/project-intelligence.json",
    "task_reports": true,
    "track_cost": true,
    "track_input_tokens": true,
    "track_output_tokens": true
  },
  "orchestration": {
    "autonomy": "agentic",
    "orchestrator": "native",
    "protocol": "POP"
  },
  "project": {
    "name": "aipo",
    "description": "Aipo: small, general-purpose, dynamically and strongly typed language with optional signature contracts. Rust-first implementation: compiler -> bytecode -> VM, with first-class JavaScript backend as roadmap. Governed by Prumo CLI.",
    "type": "programming-language"
  },
  "protocol": {
    "compatible": ">=3 <4",
    "version": 3
  },
  "quality": {
    "gates": [
      "fmt",
      "check",
      "clippy",
      "test",
      "doc"
    ],
    "clippy_deny_warnings": true
  },
  "risk": [
    "Semantic decisions not covered by canon must not be invented; open questions become ADPs (no-invention policy).",
    "Rust panics leaking as Aipo user errors; Result-based error model enforced by CI.",
    "Documentation drift between spec and implementation; prumo docs impact/delta/audit after each change."
  ],
  "stack": {
    "languages": [
      "rust"
    ],
    "build": [
      "cargo"
    ],
    "test": [
      "cargo-nextest"
    ],
    "platforms": [
      "linux",
      "macos",
      "windows"
    ]
  },
  "version": 3
}