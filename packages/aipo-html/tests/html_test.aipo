# html_test.aipo — Comprehensive unit tests for aipo.html

import aipo.html as h

test("html5 container tags and nested children tree") do {
    let tree = h.div({ "class": "container", "id": "main" }) do {
        h.header do {
            h.h1("Portal Aipo")
        }
        h.main do {
            h.section({ "class": "hero" }) do {
                h.p("Bem-vindo ao framework web declarativo.")
                h.button("Explorar", { "class": "btn-primary" })
            }
        }
        h.footer do {
            h.span("© 2026 Aipo Lang")
        }
    }
    expect.equal(tree.tag, "div")
    expect.equal(tree.attrs["class"], "container")
    expect.equal(tree.children.len(), 3)

    let header_node = tree.children[0]
    expect.equal(header_node.tag, "header")
    expect.equal(header_node.children.len(), 1)
    expect.equal(header_node.children[0].tag, "h1")
    expect.equal(header_node.children[0].text_content, "Portal Aipo")

    let main_node = tree.children[1]
    expect.equal(main_node.tag, "main")
    let section_node = main_node.children[0]
    expect.equal(section_node.tag, "section")
    expect.equal(section_node.children.len(), 2)
}
test("leaf tags and void elements") do {
    let btn = h.button("Salvar", { "type": "submit", "disabled": true })
    expect.equal(btn.tag, "button")
    expect.equal(btn.text_content, "Salvar")
    expect.equal(btn.attrs["disabled"], true)

    let img_node = h.img("avatar.png", "Avatar do Usuário", { "class": "rounded" })
    expect.equal(img_node.tag, "img")
    expect.equal(img_node.attrs["src"], "avatar.png")
    expect.equal(img_node.attrs["alt"], "Avatar do Usuário")
    expect.equal(img_node.children.len(), 0)

    let inp = h.input({ "type": "email", "placeholder": "contato@aipo.dev" })
    expect.equal(inp.tag, "input")
    expect.equal(inp.attrs["type"], "email")
}
test("ssr render_to_string serialization with escaping") do {
    let doc = h.div({ "class": "card" }) do {
        h.h2("Escaping <script> & \"quotes\"")
        h.p("Texto seguro & auditado.")
        h.img("test.png", "A & B")
        h.input({ "disabled": true, "type": "text" })
    }
    let html = h.render_to_string(doc)

    expect.true (html.contains("<div class=\"card\">"))
    expect.true (html.contains("&lt;script&gt; &amp; &quot;quotes&quot;"))
    expect.true (html.contains("Texto seguro &amp; auditado."))
    expect.true (html.contains("<img src=\"test.png\" alt=\"A &amp; B\" />"))
    expect.true (html.contains("<input disabled type=\"text\" />"))
    expect.true (html.contains("</div>"))
}
test("fragment rendering without container wrapper") do {
    let frag = h.fragment do {
        h.li("Item 1")
        h.li("Item 2")
        h.li("Item 3")
    }
    let html = h.render_to_string(frag)
    expect.equal(html, "<li>Item 1</li><li>Item 2</li><li>Item 3</li>")
}
test("css-in-aipo scoped styles and media queries") do {
    h.clear_css_registry()

    let btn_style = h.css({
            "padding": 12,
            "background": "#6366f1",
            "border_radius": 8,
            "hover": {
                "background": "#4f46e5"
            },
            "media": {
                "(min-width: 768px)": {
                    "padding": 20
                }
            }
        })

    expect.true (btn_style.starts_with("aipo-s"))

    let injected = h.get_injected_css()
    expect.true (injected.contains(f".{btn_style} {{"))
    expect.true (injected.contains("padding: 12px;"))
    expect.true (injected.contains("background: #6366f1;"))
    expect.true (injected.contains(f".{btn_style}:hover {{"))
    expect.true (injected.contains("background: #4f46e5;"))
    expect.true (injected.contains("@media (min-width: 768px) {"))
}
struct Model {
    count
}

test("mvu state updates and commands") do {
    let update = fn (m, msg) {
        if msg == "inc" {
            return Model{ count: m.count + 1 }
        } elif msg == "dec" {
            return Model{ count: m.count - 1 }
        } elif msg == "reset_and_double" {
            # Returns TEA-style tuple [new_model, cmd]
            return [Model{ count: 10 }, h.cmd_msg("inc")]
        }
        return m
    }

    let view = fn (m, dispatch) {
        return h.div do {
            h.span(f"Valor: {m.count}")
        }
    }

    let app = h.mount("#app", Model{ count: 0 }, update, view)
    expect.equal(app.current_model.count, 0)
    expect.equal(app.root_node.children[0].text_content, "Valor: 0")

    h.dispatch("inc")
    expect.equal(app.current_model.count, 1)
    expect.equal(app.root_node.children[0].text_content, "Valor: 1")

    h.dispatch("dec")
    expect.equal(app.current_model.count, 0)

    # Dispatch command chain: resets to 10 and immediately dispatches "inc" -> 11
    h.dispatch("reset_and_double")
    expect.equal(app.current_model.count, 11)
    expect.equal(app.root_node.children[0].text_content, "Valor: 11")
}
