# behaviors.aipo — Reusable pre-fabricated actor behaviors for `aipo.game`

import input as input

struct Behavior {
    name
    props
    update_fn
}

# TopDown Movement Behavior (WASD / Arrows)
fn TopDown(speed: Float, diagonal: Bool) -> Behavior {
    let update = fn (actor, dt) {
        let ax = input.axis_x()
        let ay = input.axis_y()

        actor.vx = ax * speed
        actor.vy = ay * speed

        actor.x += actor.vx * dt
        actor.y += actor.vy * dt
    }

    return Behavior {
        name: "TopDown",
        props: { "speed": speed },
        update_fn: update
    }
}

# Platformer 2D Physics Behavior
fn Platformer(speed: Float, jump_force: Float, gravity: Float) -> Behavior {
    let update = fn (actor, dt) {
        let ax = input.axis_x()
        actor.vx = ax * speed

        # Apply gravity
        actor.vy += gravity * dt

        # Jump trigger
        if input.key_pressed("Space") or input.key_pressed("ArrowUp") or input.key_pressed("W") {
            if actor.is_on_ground {
                actor.vy = -jump_force
                actor.is_on_ground = false
            }
        }

        actor.x += actor.vx * dt
        actor.y += actor.vy * dt
    }

    return Behavior {
        name: "Platformer",
        props: {
            "speed": speed,
            "jump_force": jump_force,
            "gravity": gravity
        },
        update_fn: update
    }
}

# Linear Directional Bullet Behavior
fn Bullet(speed: Float, angle: Float) -> Behavior {
    let update = fn (actor, dt) {
        # angle in degrees, -90 is up, 90 is down, 0 is right, 180 is left
        if angle == -90.0 {
            actor.y -= speed * dt
        } elif angle == 90.0 {
            actor.y += speed * dt
        } elif angle == 180.0 {
            actor.x -= speed * dt
        } else {
            actor.x += speed * dt
        }
    }

    return Behavior {
        name: "Bullet",
        props: { "speed": speed, "angle": angle },
        update_fn: update
    }
}

# Solid Collider Behavior (Obstacle for Platformer/TopDown)
fn Solid() -> Behavior {
    let update = fn (actor, dt) {
        # Marker behavior for spatial collision solver
    }

    return Behavior {
        name: "Solid",
        props: { "is_solid": true },
        update_fn: update
    }
}

# Wrap Around Screen Edges
fn WrapScreen(margin: Float) -> Behavior {
    let update = fn (actor, dt) {
        # Screen bounds wrap
        if actor.x < -margin {
            actor.x = 800.0 + margin
        } elif actor.x > 800.0 + margin {
            actor.x = -margin
        }

        if actor.y < -margin {
            actor.y = 600.0 + margin
        } elif actor.y > 600.0 + margin {
            actor.y = -margin
        }
    }

    return Behavior {
        name: "WrapScreen",
        props: { "margin": margin },
        update_fn: update
    }
}

# Keep Within Screen Bounds
fn KeepInScreen(margin: Float) -> Behavior {
    let update = fn (actor, dt) {
        if actor.x < margin {
            actor.x = margin
        } elif actor.x > 800.0 - margin {
            actor.x = 800.0 - margin
        }

        if actor.y < margin {
            actor.y = margin
        } elif actor.y > 600.0 - margin {
            actor.y = 600.0 - margin
        }
    }

    return Behavior {
        name: "KeepInScreen",
        props: { "margin": margin },
        update_fn: update
    }
}

# Auto Destroy Outside Screen
fn DestroyOutsideScreen(margin: Float) -> Behavior {
    let update = fn (actor, dt) {
        if actor.x < -margin or actor.x > 800.0 + margin or actor.y < -margin or actor.y > 600.0 + margin {
            actor.is_alive = false
        }
    }

    return Behavior {
        name: "DestroyOutsideScreen",
        props: { "margin": margin },
        update_fn: update
    }
}

export Behavior, TopDown, Platformer, Bullet, Solid, WrapScreen, KeepInScreen, DestroyOutsideScreen
