test("leona layout min_width and max_width constraints") do {
    let wide_card = zoe.card({
            "width": "100%",
            "max_width": 500.0,
            "height": 100.0
        }, [])

    zoe.compute_layout(wide_card, 800.0, 600.0)
    expect.equal(wide_card.layout.width, 500.0)

    let tiny_card = zoe.card({
            "width": 50.0,
            "min_width": 140.0,
            "height": 100.0
        }, [])

    zoe.compute_layout(tiny_card, 800.0, 600.0)
    expect.equal(tiny_card.layout.width, 140.0)
}
test("leona layout min_height and max_height constraints") do {
    let tall_card = zoe.card({
            "width": 200.0,
            "height": "100%",
            "max_height": 280.0
        }, [])

    zoe.compute_layout(tall_card, 800.0, 600.0)
    expect.equal(tall_card.layout.height, 280.0)

    let short_card = zoe.card({
            "width": 200.0,
            "height": 30.0,
            "min_height": 90.0
        }, [])

    zoe.compute_layout(short_card, 800.0, 600.0)
    expect.equal(short_card.layout.height, 90.0)
}
test("leona multi-line flow wrap layout") do {
    let c1 = zoe.rect({ "width": 90.0, "height": 30.0 }, [])
    let c2 = zoe.rect({ "width": 90.0, "height": 30.0 }, [])
    let c3 = zoe.rect({ "width": 90.0, "height": 30.0 }, [])

    let flow_row = zoe.row({
            "wrap": true,
            "width": 200.0,
            "height": "auto",
            "padding": 0.0,
            "gap": 10.0
        }, [c1, c2, c3])

    zoe.compute_layout(flow_row, 800.0, 600.0)

    # Line 1: c1 at x=0, c2 at x=100 (90 + 10 gap)
    expect.equal(c1.layout.x, 0.0)
    expect.equal(c1.layout.y, 0.0)
    expect.equal(c2.layout.x, 100.0)
    expect.equal(c2.layout.y, 0.0)

    # Line 2: c3 wraps to new line at x=0, y=40 (30 height + 10 gap)
    expect.equal(c3.layout.x, 0.0)
    expect.equal(c3.layout.y, 40.0)

    # Container hugs two lines: 30 + 10 + 30 = 70.0
    expect.equal(flow_row.layout.height, 70.0)
}
test("leona stack container overlapping layout") do {
    let bg = zoe.rect({ "width": 400.0, "height": 300.0 }, [])
    let overlay_badge = zoe.rect({ "width": 60.0, "height": 24.0, "offset_x": 16.0, "offset_y": 16.0 }, [])

    let stk = zoe.stack({ "width": 400.0, "height": 300.0 }, [bg, overlay_badge])
    zoe.compute_layout(stk, 800.0, 600.0)

    expect.equal(stk.layout.width, 400.0)
    expect.equal(stk.layout.height, 300.0)

    expect.equal(bg.layout.x, 0.0)
    expect.equal(bg.layout.y, 0.0)
    expect.equal(overlay_badge.layout.x, 16.0)
    expect.equal(overlay_badge.layout.y, 16.0)
}
test("use_memo caching and dependency invalidation") do {
    let tracker = { "computations": 0 }
    let count = zoe.use_state(10)

    let compute = fn () {
        tracker["computations"] = tracker["computations"] + 1
        return count.get() * 2
    }

    # Pass 1: compute initial memo
    let m1 = zoe.use_memo(compute, [count.get()])
    expect.equal(m1.get(), 20)
    expect.equal(tracker["computations"], 1)

    # Pass 2: memo caches value without re-running compute()
    expect.equal(m1.value, 20)
    expect.equal(tracker["computations"], 1)
}
test("use_effect lifecycle tracking") do {
    let tracker = { "ran": false, "cleaned_up": false }

    let effect = fn () {
        tracker["ran"] = true
        return fn () {
            tracker["cleaned_up"] = true
        }
    }

    zoe.use_effect(effect, ["initial"])
    expect.true (tracker["ran"])
    expect.false (tracker["cleaned_up"])
}
test("focus ring and focus tracking state") do {
    let btn1 = zoe.button("Opção 1", none, { "focusable": true })
    let btn2 = zoe.button("Opção 2", none, { "focusable": true })

    expect.false (btn1.is_focused)
    expect.false (btn2.is_focused)

    # Focus btn1
    zoe.set_focused_node(btn1)
    expect.true (btn1.is_focused)
    expect.equal(zoe.get_focused_node().id, btn1.id)

    # Shift focus to btn2
    zoe.set_focused_node(btn2)
    expect.false (btn1.is_focused)
    expect.true (btn2.is_focused)
    expect.equal(zoe.get_focused_node().id, btn2.id)

    # Clear focus
    zoe.set_focused_node(none)
    expect.false (btn2.is_focused)
    expect.equal(zoe.get_focused_node(), none)
}
