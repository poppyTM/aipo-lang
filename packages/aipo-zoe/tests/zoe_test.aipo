    let vlist = zoe.virtual_list({
            "item_count": 10000,
            "item_height": 30.0,
            "height": 300.0,
            "scroll": 0.0,
            "render_item": fn (i) {
                return zoe.label(f"Item #{i}")
            }
        })

    expect.equal(vlist.tag, "virtual_list")
