test("use_tween interpolation over time") do {
    let tw = zoe.use_tween(0.0, 100.0, 1.0, "linear")
    expect.equal(tw.get(), 0.0)
    expect.equal(tw.target_val, 100.0)
    expect.equal(tw.start_val, 0.0)

    # Advance 0.5s (50% progress in linear easing -> 50.0)
    zoe.step(0.5)
    expect.equal(tw.get(), 50.0)

    # Advance another 0.5s -> 100.0 (reached target)
    zoe.step(0.5)
    expect.equal(tw.get(), 100.0)
}
