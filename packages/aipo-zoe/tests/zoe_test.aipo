test("node_graph advanced widget creation and bezier cables") do {
    let nodes_def = [
        {
            "id": "tex",
            "title": "Texture 2D",
            "x": 40.0,
            "y": 50.0,
            "outputs": [{ "name": "RGBA", "color": zoe.color.yellow }]
        },
        {
            "id": "out",
            "title": "Fragment Output",
            "x": 280.0,
            "y": 60.0,
            "inputs": [{ "name": "Color", "color": zoe.color.green }]
        }
    ]
    let wires_def = [
        {
            "from_node": "tex",
            "from_socket": "RGBA",
            "to_node": "out",
            "to_socket": "Color",
            "color": zoe.color.yellow
        }
    ]

    let graph = zoe.node_graph({
            "nodes": nodes_def,
            "connections": wires_def,
            "width": 600.0,
            "height": 340.0
        })

    expect.equal(graph.tag, "node_graph")
    expect.true (graph.props["clip"])
    expect.true (graph.props.has("on_custom_draw"))

    zoe.compute_layout(graph, 800.0, 600.0)
    expect.equal(graph.layout.width, 600.0)
    expect.equal(graph.layout.height, 340.0)

    # Execute custom draw with host_draw_bezier headlessly without panic
    let draw_fn = graph.props["on_custom_draw"]
    (draw_fn)(graph)
}
