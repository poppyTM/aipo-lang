# zoe_test.aipo — Comprehensive unit tests for Zoe UI and Leona layout engine in Aipo

import aipo.zoe as zoe

test("color palette and hex parsing") do {
    let c1 = zoe.rgb(255, 128, 0)
    expect.equal(c1.r, 1.0)
    expect.approx(c1.g, 0.5019, 0.01)
    expect.equal(c1.b, 0.0)
    expect.equal(c1.a, 1.0)

    let c2 = zoe.rgba(0, 255, 0, 0.5)
    expect.equal(c2.r, 0.0)
    expect.equal(c2.g, 1.0)
    expect.equal(c2.b, 0.0)
    expect.equal(c2.a, 0.5)

    let hex_c = zoe.hex("#ffffff")
    expect.equal(hex_c.r, 1.0)
    expect.equal(hex_c.g, 1.0)
    expect.equal(hex_c.b, 1.0)

    # Catppuccin palette dictionary access
    expect.equal(zoe.color.white.r, 1.0)
    expect.true (zoe.color.blue.b > 0.9)
    expect.true (zoe.color.green.g > 0.8)
}
test("reactive hooks use_state and set_state") do {
    let sig = zoe.use_state(100)
    expect.equal(sig.get(), 100)

    zoe.set_state(sig, 250)
    expect.equal(sig.get(), 250)

    zoe.set_state(sig, sig.get() + 50)
    expect.equal(sig.get(), 300)
}
test("element and component trees creation with optional props") do {
    let btn_clicked = zoe.use_state(false)
    # Button with default props
    let btn_simple = zoe.button("OK")
    expect.equal(btn_simple.tag, "button")
    expect.equal(btn_simple.children.len(), 1)

    # Button with full props
    let btn = zoe.button("Clique Aqui", _ => zoe.set_state(btn_clicked, true), { "variant": "primary" })
    expect.equal(btn.tag, "button")
    expect.true (btn.props.has("on_click"))
    expect.equal(btn.children.len(), 1)

    # Switch with default props
    let sw = zoe.switch(true)
    expect.equal(sw.tag, "switch")

    # Slider with default props
    let sl = zoe.slider(50.0, 0.0, 100.0)
    expect.equal(sl.tag, "slider")

    # Progress bar with default props
    let pb = zoe.progress_bar(0.75)
    expect.equal(pb.tag, "progress_bar")

    # Badge with default props
    let bdg = zoe.badge("Ativo")
    expect.equal(bdg.tag, "badge")

    # Card with ergonomic child list
    let crd = zoe.card([btn, sw])
    expect.equal(crd.tag, "card")
    expect.equal(crd.children.len(), 2)
}
test("ergonomic layout containers column row stack center spacer divider") do {
    let b1 = zoe.button("A")
    let b2 = zoe.button("B")

    # Column without props
    let col = zoe.column([b1, b2])
    expect.equal(col.props["direction"], "column")
    expect.equal(col.children.len(), 2)

    # Row with props
    let r = zoe.row({ "gap": 10.0 }, [b1, b2])
    expect.equal(r.props["direction"], "row")
    expect.equal(r.props["gap"], 10.0)

    # Stack
    let stk = zoe.stack([b1, b2])
    expect.equal(stk.props["direction"], "stack")

    # Center
    let cnt = zoe.center([b1])
    expect.equal(cnt.props["align_items"], "center")
    expect.equal(cnt.props["justify_content"], "center")

    # Spacer
    let sp = zoe.spacer()
    expect.equal(sp.tag, "spacer")
    expect.equal(sp.props["width"], "flex")

    # Divider
    let div_h = zoe.divider()
    expect.equal(div_h.tag, "divider")
    expect.equal(div_h.props["width"], "100%")

    let div_v = zoe.divider({ "direction": "vertical" })
    expect.equal(div_v.props["height"], "100%")
}
test("leona layout engine coordinates calculation") do {
    let child1 = zoe.rect({ "width": 100.0, "height": 40.0 }, [])
    let child2 = zoe.rect({ "width": 150.0, "height": 60.0 }, [])
    let container = zoe.rect(
        {
            "direction": "column",
            "width": 400.0,
            "height": 300.0,
            "padding": 10.0,
            "gap": 15.0
        },
        [child1, child2]
    )

    zoe.compute_layout(container, 800.0, 600.0)

    # Root bounds
    expect.equal(container.layout.x, 0.0)
    expect.equal(container.layout.y, 0.0)
    expect.equal(container.layout.width, 400.0)
    expect.equal(container.layout.height, 300.0)

    # Children bounds in column direction
    let c1_bounds = child1.layout
    expect.equal(c1_bounds.x, 10.0)
    expect.equal(c1_bounds.y, 10.0)
    expect.equal(c1_bounds.width, 100.0)
    expect.equal(c1_bounds.height, 40.0)

    let c2_bounds = child2.layout
    expect.equal(c2_bounds.x, 10.0)
    expect.equal(c2_bounds.y, 65.0)
    expect.equal(c2_bounds.width, 150.0)
    expect.equal(c2_bounds.height, 60.0)
}
test("leona layout percentage sizing") do {
    let child = zoe.rect({ "width": "50%", "height": "25%" }, [])
    let root = zoe.rect({ "width": 800.0, "height": 400.0 }, [child])

    zoe.compute_layout(root, 800.0, 400.0)

    let c_bounds = child.layout
    expect.equal(c_bounds.width, 400.0)
    expect.equal(c_bounds.height, 100.0)
}
test("rect point containment hit testing") do {
    let r = zoe.create_rect(10.0, 10.0, 100.0, 40.0)
    expect.true (r.contains(20.0, 20.0))
    expect.false (r.contains(5.0, 20.0))
    expect.false (r.contains(120.0, 20.0))
    expect.false (r.contains(20.0, 60.0))
}
test("split_view horizontal layout and proportion calculation") do {
    let p1 = zoe.label("Left Panel")
    let p2 = zoe.label("Right Panel")
    let sv = zoe.split_view({ "split": 0.25, "direction": "horizontal", "handle_size": 6.0 }, p1, p2)

    zoe.compute_layout(sv, 800.0, 600.0)

    expect.equal(sv.layout.width, 800.0)
    expect.equal(sv.layout.height, 600.0)

    # First wrapper (25% of 800.0 = 200.0)
    let first_wrapper = sv.children[0]
    expect.equal(first_wrapper.layout.x, 0.0)
    expect.equal(first_wrapper.layout.width, 200.0)

    # Handle (width = 6.0 at x = 200.0)
    let handle = sv.children[1]
    expect.equal(handle.layout.x, 200.0)
    expect.equal(handle.layout.width, 6.0)

    # Second wrapper (flex = 800 - 200 - 6 = 594.0 at x = 206.0)
    let second_wrapper = sv.children[2]
    expect.equal(second_wrapper.layout.x, 206.0)
    expect.equal(second_wrapper.layout.width, 594.0)
}
test("split_view vertical layout and proportion calculation") do {
    let p1 = zoe.label("Top Panel")
    let p2 = zoe.label("Bottom Panel")
    let sv = zoe.split_view({ "split": 0.30, "direction": "vertical", "handle_size": 8.0 }, p1, p2)

    zoe.compute_layout(sv, 800.0, 600.0)

    expect.equal(sv.layout.width, 800.0)
    expect.equal(sv.layout.height, 600.0)

    # First wrapper (30% of 600.0 = 180.0)
    let first_wrapper = sv.children[0]
    expect.equal(first_wrapper.layout.y, 0.0)
    expect.equal(first_wrapper.layout.height, 180.0)

    # Handle (height = 8.0 at y = 180.0)
    let handle = sv.children[1]
    expect.equal(handle.layout.y, 180.0)
    expect.equal(handle.layout.height, 8.0)

    # Second wrapper (flex = 600 - 180 - 8 = 412.0 at y = 188.0)
    let second_wrapper = sv.children[2]
    expect.equal(second_wrapper.layout.y, 188.0)
    expect.equal(second_wrapper.layout.height, 412.0)
}
test("split_view drag handler clamping and signal update") do {
    let split_sig = zoe.use_state(0.50)
    let p1 = zoe.label("Panel A")
    let p2 = zoe.label("Panel B")
    let sv = zoe.split_view({
            "split": split_sig,
            "direction": "horizontal",
            "min_first": 100.0,
            "min_second": 100.0
        }, p1, p2)

    zoe.compute_layout(sv, 800.0, 600.0)
    let handle = sv.children[1]
    let on_drag = handle.props["on_drag"]

    # Drag to 200px (25%)
    (on_drag)({ "x": 200.0, "y": 0.0, "dx": -200.0, "dy": 0.0 })
    expect.equal(split_sig.get(), 0.25)

    # Drag to 40px (below min_first 100px -> clamped to 100 / 800 = 0.125)
    (on_drag)({ "x": 40.0, "y": 0.0, "dx": -160.0, "dy": 0.0 })
    expect.equal(split_sig.get(), 0.125)

    # Drag to 760px (violates min_second 100px -> clamped to 1.0 - 100/800 = 0.875)
    (on_drag)({ "x": 760.0, "y": 0.0, "dx": 720.0, "dy": 0.0 })
    expect.equal(split_sig.get(), 0.875)
}
test("tab_bar layout and reactive tab switching") do {
    let active_tab = zoe.use_state("scene")
    let bar = zoe.tab_bar({
            "active": active_tab,
            "tabs": [
            { "id": "scene", "label": "Cena" },
            { "id": "game", "label": "Jogo" }
            ]
        })

    expect.equal(bar.tag, "tab_bar")
    expect.equal(bar.children.len(), 2)

    # First tab is active, has indicator
    let tab0 = bar.children[0]
    expect.equal(tab0.tag, "tab_item")
    expect.equal(tab0.children.len(), 2) # label + tab_indicator

    # Click second tab
    let tab1 = bar.children[1]
    let on_click = tab1.props["on_click"]
    (on_click)({})
    expect.equal(active_tab.get(), "game")
}
test("tab_view high-level container with flex content height") do {
    let active_tab = zoe.use_state("console")
    let p_console = zoe.label("Log output")
    let p_assets = zoe.label("Sprite.png")

    let tv = zoe.tab_view(
        {
            "active": active_tab,
            "height": 400.0,
            "tabs": [
            { "id": "console", "label": "Console" },
            { "id": "assets", "label": "Assets" }
            ]
        },
        {
            "console": p_console,
            "assets": p_assets
        }
    )

    zoe.compute_layout(tv, 800.0, 400.0)

    expect.equal(tv.layout.height, 400.0)
    expect.equal(tv.children.len(), 2)

    # Tab bar on top (height = 34.0)
    let bar = tv.children[0]
    expect.equal(bar.layout.height, 34.0)

    # Content container flex fills rest: 400.0 - 34.0 = 366.0
    let content = tv.children[1]
    expect.equal(content.layout.height, 366.0)
}
test("scroll_view layout and offset calculation") do {
    let items = [
        zoe.label("Entity 1"),
        zoe.label("Entity 2"),
        zoe.label("Entity 3")
    ]
    let sv = zoe.scroll_view({ "height": 200.0, "scroll_y": 50.0 }, items)

    expect.equal(sv.tag, "scroll_view")
    expect.true (sv.props["clip"])
    expect.true (sv.props.has("on_wheel"))

    zoe.compute_layout(sv, 400.0, 200.0)
    expect.equal(sv.layout.width, 400.0)
    expect.equal(sv.layout.height, 200.0)

    # First child is viewport with clip: true
    let viewport = sv.children[0]
    expect.equal(viewport.tag, "scroll_viewport")
    expect.true (viewport.props["clip"])

    # Content inside viewport has offset_y = -50.0
    let content = viewport.children[0]
    expect.equal(content.tag, "scroll_content")
    expect.equal(content.props["offset_y"], -50.0)
}
test("scroll_view wheel event handling and signal update") do {
    let scroll_sig = zoe.use_state(0.0)
    let items = [zoe.label("Log line")]
    let sv = zoe.scroll_view({ "scroll_y": scroll_sig, "scroll_speed": 20.0 }, items)

    let on_wheel = sv.props["on_wheel"]

    # Scroll wheel down (negative wheel_y delta pushes content up, increasing scroll_y)
    (on_wheel)({ "wheel_y": -1.0, "wheel_x": 0.0 })
    expect.equal(scroll_sig.get(), 20.0)

    # Scroll more down
    (on_wheel)({ "wheel_y": -2.0, "wheel_x": 0.0 })
    expect.equal(scroll_sig.get(), 60.0)

    # Scroll up past top boundary (clamped to 0.0)
    (on_wheel)({ "wheel_y": 5.0, "wheel_x": 0.0 })
    expect.equal(scroll_sig.get(), 0.0)
}
test("viewport node properties, layout, and clipping defaults") do {
    var render_called = false
    let dummy_render = fn (r) {
        render_called = true
    }
    let vp = zoe.viewport({
            "width": 640.0,
            "height": 480.0,
            "on_render": dummy_render
        })

    expect.equal(vp.tag, "viewport")
    expect.true (vp.props["clip"])
    expect.true (vp.props.has("on_render"))

    zoe.compute_layout(vp, 800.0, 600.0)
    expect.equal(vp.layout.width, 640.0)
    expect.equal(vp.layout.height, 480.0)
}
test("viewport screen_to_world coordinates conversion") do {
    let rect = { "x": 100.0, "y": 50.0, "width": 600.0, "height": 400.0 }

    # Center of viewport screen -> (400, 250) should be at world origin (0, 0)
    let center_pos = zoe.screen_to_world(rect, 400.0, 250.0, 0.0, 0.0, 1.0)
    expect.equal(center_pos["x"], 0.0)
    expect.equal(center_pos["y"], 0.0)

    # Offset with camera pan (cam_x: 10, cam_y: 20) and 2x zoom
    # local_x = 500 - 100 = 400. (400 - 300) / 2 = 50 -> world_x = 10 + 50 = 60
    # local_y = 300 - 50 = 250. (250 - 200) / 2 = 25 -> world_y = 20 + 25 = 45
    let offset_pos = zoe.screen_to_world(rect, 500.0, 300.0, 10.0, 20.0, 2.0)
    expect.equal(offset_pos["x"], 60.0)
    expect.equal(offset_pos["y"], 45.0)
}
test("viewport on_render execution and camera dispatch") do {
    let tracker = { "width": 0.0, "height": 0.0 }
    let render_cam_fn = fn (r) {
        tracker["width"] = r["width"]
        tracker["height"] = r["height"]
        zoe.set_viewport_camera(r, 0.0, 0.0, 1.5)
    }
    let vp = zoe.viewport({
            "width": 500.0,
            "height": 300.0,
            "on_render": render_cam_fn
        })

    zoe.compute_layout(vp, 800.0, 600.0)
    let on_render_fn = vp.props["on_render"]
    (on_render_fn)({ "x": vp.layout.x, "y": vp.layout.y, "width": vp.layout.width, "height": vp.layout.height })

    expect.equal(tracker["width"], 500.0)
    expect.equal(tracker["height"], 300.0)
}
test("text_input typing, backspace, and state update") do {
    let name_sig = zoe.use_state("Hero")
    let input = zoe.text_input({
            "value": name_sig,
            "width": 180.0
        })

    expect.equal(input.tag, "text_input")
    expect.true (input.props.has("on_char"))
    expect.true (input.props.has("on_backspace"))

    let on_char = input.props["on_char"]
    let on_bs = input.props["on_backspace"]

    # Type exclamation mark
    (on_char)("!")
    expect.equal(name_sig.get(), "Hero!")

    # Type letter 's'
    (on_char)("s")
    expect.equal(name_sig.get(), "Hero!s")

    # Backspace twice
    (on_bs)()
    expect.equal(name_sig.get(), "Hero!")
    (on_bs)()
    expect.equal(name_sig.get(), "Hero")
}
test("number_input stepper decrement and increment") do {
    let pos_sig = zoe.use_state(10.0)
    let num_in = zoe.number_input({
            "value": pos_sig,
            "step": 2.5,
            "min": 0.0,
            "max": 50.0
        })

    expect.equal(num_in.tag, "number_input")
    expect.equal(num_in.children.len(), 3)

    let dec_btn = num_in.children[0]
    let inc_btn = num_in.children[2]

    # Increment +2.5 -> 12.5
    let on_inc = inc_btn.props["on_click"]
    (on_inc)({})
    expect.equal(pos_sig.get(), 12.5)

    # Increment +2.5 -> 15.0
    (on_inc)({})
    expect.equal(pos_sig.get(), 15.0)

    # Decrement -2.5 -> 12.5
    let on_dec = dec_btn.props["on_click"]
    (on_dec)({})
    expect.equal(pos_sig.get(), 12.5)
}
test("dropdown_select cycle through options") do {
    let sel_sig = zoe.use_state("Player")
    let dd = zoe.dropdown_select({
            "options": ["Player", "Enemy", "Item"],
            "selected": sel_sig,
            "cycle": true
        })

    expect.equal(dd.tag, "dropdown_select")
    let on_toggle = dd.props["on_click"]

    (on_toggle)({})
    expect.equal(sel_sig.get(), "Enemy")

    (on_toggle)({})
    expect.equal(sel_sig.get(), "Item")

    (on_toggle)({})
    expect.equal(sel_sig.get(), "Player")
}
test("color_picker cycles through palette") do {
    let col_sig = zoe.use_state(zoe.color.blue)
    let cp = zoe.color_picker({
            "color": col_sig
        })

    expect.equal(cp.tag, "color_picker")
    let on_pick = cp.props["on_click"]

    (on_pick)({})
    # Next color after blue is green
    expect.equal(col_sig.get().g, zoe.color.green.g)
}
test("world_to_screen and screen_to_world roundtrip") do {
    let rect = { "x": 100.0, "y": 50.0, "width": 400.0, "height": 300.0 }
    let cam_x = 25.0
    let cam_y = -10.0
    let zoom = 1.5

    # Center of viewport in screen space
    let screen_center_x = 100.0 + 200.0
    let screen_center_y = 50.0 + 150.0

    # Camera target in world space should be exactly at the center of viewport
    let s = zoe.world_to_screen(rect, cam_x, cam_y, cam_x, cam_y, zoom)
    expect.equal(s["x"], screen_center_x)
    expect.equal(s["y"], screen_center_y)

    # Invert back to world
    let w = zoe.screen_to_world(rect, s["x"], s["y"], cam_x, cam_y, zoom)
    expect.equal(w["x"], cam_x)
    expect.equal(w["y"], cam_y)

    # Arbitrary point roundtrip
    let orig_wx = 120.0
    let orig_wy = -75.0
    let pt_screen = zoe.world_to_screen(rect, orig_wx, orig_wy, cam_x, cam_y, zoom)
    let pt_world = zoe.screen_to_world(rect, pt_screen["x"], pt_screen["y"], cam_x, cam_y, zoom)
    expect.equal(pt_world["x"], orig_wx)
    expect.equal(pt_world["y"], orig_wy)
}
test("point_in_rect bounding box testing") do {
    expect.true (zoe.point_in_rect(15.0, 25.0, 10.0, 20.0, 50.0, 50.0))
    expect.true (zoe.point_in_rect(10.0, 20.0, 10.0, 20.0, 50.0, 50.0))
    expect.true (zoe.point_in_rect(60.0, 70.0, 10.0, 20.0, 50.0, 50.0))

    expect.false (zoe.point_in_rect(5.0, 25.0, 10.0, 20.0, 50.0, 50.0))
    expect.false (zoe.point_in_rect(15.0, 15.0, 10.0, 20.0, 50.0, 50.0))
    expect.false (zoe.point_in_rect(65.0, 25.0, 10.0, 20.0, 50.0, 50.0))
    expect.false (zoe.point_in_rect(15.0, 75.0, 10.0, 20.0, 50.0, 50.0))
}
test("test_gizmo_hit detection for center, x, and y axes") do {
    let gx = 200.0
    let gy = 150.0

    # Center handle hit
    expect.equal(zoe.test_gizmo_hit(200.0, 150.0, gx, gy), "center")
    expect.equal(zoe.test_gizmo_hit(204.0, 153.0, gx, gy), "center")

    # X axis handle hit (horizontal to the right)
    expect.equal(zoe.test_gizmo_hit(225.0, 150.0, gx, gy), "x")
    expect.equal(zoe.test_gizmo_hit(245.0, 152.0, gx, gy), "x")

    # Y axis handle hit (vertical upwards: -Y)
    expect.equal(zoe.test_gizmo_hit(200.0, 125.0, gx, gy), "y")
    expect.equal(zoe.test_gizmo_hit(198.0, 110.0, gx, gy), "y")

    # Miss / empty space
    expect.equal(zoe.test_gizmo_hit(250.0, 250.0, gx, gy), "none")
    expect.equal(zoe.test_gizmo_hit(150.0, 150.0, gx, gy), "none")
    expect.equal(zoe.test_gizmo_hit(200.0, 200.0, gx, gy), "none")
}
test("draw_gizmo_2d execution without error") do {
    zoe.draw_gizmo_2d(100.0, 100.0, 45.0, "none")
    zoe.draw_gizmo_2d(100.0, 100.0, 45.0, "x")
    zoe.draw_gizmo_2d(100.0, 100.0, 45.0, "y")
    zoe.draw_gizmo_2d(100.0, 100.0, 45.0, "center")
}
test("viewport entity picking and constrained transform gizmo motion") do {
    let rect = { "x": 100.0, "y": 50.0, "width": 800.0, "height": 600.0 }
    let cam_x = 0.0
    let cam_y = 0.0
    let zoom = 1.0

    # Entity states
    var entity_x = 0.0
    var entity_y = 0.0
    let entity_w = 48.0
    let entity_h = 48.0

    # 1. World to screen position
    let s = zoe.world_to_screen(rect, entity_x, entity_y, cam_x, cam_y, zoom)
    let cx = s["x"]
    let cy = s["y"]

    # 2. Picking test: click inside entity box should hit
    let hit_center = zoe.point_in_rect(cx, cy, cx - entity_w / 2.0, cy - entity_h / 2.0, entity_w, entity_h)
    expect.true (hit_center)

    let hit_outside = zoe.point_in_rect(cx + 100.0, cy + 100.0, cx - entity_w / 2.0, cy - entity_h / 2.0, entity_w, entity_h)
    expect.false (hit_outside)

    # 3. Gizmo hit test on X handle (gx + 30.0, gy)
    let mode_x = zoe.test_gizmo_hit(cx + 30.0, cy, cx, cy, 50.0)
    expect.equal(mode_x, "x")

    # 4. Constrained motion in X: dragging by dx = 15.0, dy = 10.0 should ONLY update entity_x
    let dx = 15.0
    let dy = 10.0
    if mode_x == "x" or mode_x == "center" {
        entity_x += dx / zoom
    }
    if mode_x == "y" or mode_x == "center" {
        entity_y += dy / zoom
    }
    expect.equal(entity_x, 15.0)
    expect.equal(entity_y, 0.0)

    # 5. Constrained motion in Y: dragging by dx = 20.0, dy = -25.0 on Y handle
    let mode_y = zoe.test_gizmo_hit(cx + 15.0, cy - 30.0, cx + 15.0, cy, 50.0)
    expect.equal(mode_y, "y")
    if mode_y == "x" or mode_y == "center" {
        entity_x += 20.0 / zoom
    }
    if mode_y == "y" or mode_y == "center" {
        entity_y += -25.0 / zoom
    }
    expect.equal(entity_x, 15.0)
    expect.equal(entity_y, -25.0)
}
test("retro3d vector math operations") do {
    let a = zoe.vec3(1.0, 2.0, 3.0)
    let b = zoe.vec3(4.0, 5.0, 6.0)

    let sum = zoe.vec3_add(a, b)
    expect.equal(sum["x"], 5.0)
    expect.equal(sum["y"], 7.0)
    expect.equal(sum["z"], 9.0)

    let diff = zoe.vec3_sub(b, a)
    expect.equal(diff["x"], 3.0)
    expect.equal(diff["y"], 3.0)
    expect.equal(diff["z"], 3.0)

    let scaled = zoe.vec3_scale(a, 2.0)
    expect.equal(scaled["x"], 2.0)
    expect.equal(scaled["y"], 4.0)
    expect.equal(scaled["z"], 6.0)
}
test("retro3d camera pinhole perspective projection") do {
    let rect = { "x": 0.0, "y": 0.0, "width": 800.0, "height": 600.0 }
    let cam = zoe.camera_3d(0.0, 0.0, 100.0, 0.0, 0.0, 0.0, 300.0)

    # Point at world origin (target of camera)
    let p = zoe.project_3d(0.0, 0.0, 0.0, cam, rect)
    expect.true (p["visible"])
    # Should project directly at viewport center
    expect.equal(p["x"], 400.0)
    expect.equal(p["y"], 300.0)
    expect.true (p["depth"] > 0.0)
}
test("retro3d mesh primitives creation") do {
    let cube = zoe.cube_mesh(20.0, 20.0, 20.0, zoe.color.blue)
    expect.equal(cube["vertices"].len(), 8)
    expect.equal(cube["triangles"].len(), 12)

    let pyr = zoe.pyramid_mesh(16.0, 24.0, zoe.color.yellow)
    expect.equal(pyr["vertices"].len(), 5)
    expect.equal(pyr["triangles"].len(), 6)
}
test("retro3d 3D grid and mesh rasterization execution") do {
    let rect = { "x": 50.0, "y": 50.0, "width": 640.0, "height": 480.0 }
    let cam = zoe.camera_3d(0.5, 0.4, 180.0, 0.0, 0.0, 0.0, 320.0)

    # Grid
    zoe.draw_grid_3d(cam, rect, 150.0, 30.0)

    # Solid mesh rendering (with lighting and painter's algorithm)
    let cube = zoe.cube_mesh(30.0, 30.0, 30.0, zoe.color.blue)
    zoe.render_mesh_3d(cube, zoe.vec3(0.0, 15.0, 0.0), 0.2, 0.1, cam, rect, false)

    # Wireframe mesh rendering
    let pyr = zoe.pyramid_mesh(20.0, 30.0, zoe.color.green)
    zoe.render_mesh_3d(pyr, zoe.vec3(40.0, 15.0, 0.0), 0.0, 0.0, cam, rect, true)
}
test("retro3d 3D gizmo rendering and hit detection") do {
    let rect = { "x": 0.0, "y": 0.0, "width": 800.0, "height": 600.0 }
    let cam = zoe.camera_3d(0.0, 0.0, 100.0, 0.0, 0.0, 0.0, 300.0)
    let obj_pos = zoe.vec3(0.0, 0.0, 0.0)

    # Draw gizmo
    zoe.draw_gizmo_3d(obj_pos, cam, rect, 40.0, "none")
    zoe.draw_gizmo_3d(obj_pos, cam, rect, 40.0, "x")
    zoe.draw_gizmo_3d(obj_pos, cam, rect, 40.0, "y")
    zoe.draw_gizmo_3d(obj_pos, cam, rect, 40.0, "z")

    # Center handle is at screen (400, 300)
    let hit_center = zoe.test_gizmo_3d_hit(400.0, 300.0, obj_pos, cam, rect, 40.0)
    expect.equal(hit_center, "center")

    # Miss
    let hit_miss = zoe.test_gizmo_3d_hit(100.0, 100.0, obj_pos, cam, rect, 40.0)
    expect.equal(hit_miss, "none")
}
test("overlay stack management push pop and clear") do {
    zoe.clear_overlays()
    expect.false (zoe.has_overlays())

    let dummy_elem = zoe.rect({ "width": 200.0, "height": 100.0 })
    let id1 = zoe.push_overlay(dummy_elem, { "dismissible": true })
    expect.true (zoe.has_overlays())
    expect.true (id1 > 0)

    let top = zoe.get_top_overlay()
    expect.equal(top.id, id1)
    expect.true (top.dismissible)
    expect.false (top.scrim)

    let dummy2 = zoe.rect({ "width": 300.0, "height": 200.0 })
    let id2 = zoe.push_overlay(dummy2, { "scrim": true })
    let top2 = zoe.get_top_overlay()
    expect.equal(top2.id, id2)
    expect.true (top2.scrim)

    let popped = zoe.pop_overlay()
    expect.true (popped)
    expect.equal(zoe.get_top_overlay().id, id1)

    zoe.clear_overlays()
    expect.false (zoe.has_overlays())
}
test("modal dialog creation and layout") do {
    zoe.clear_overlays()
    var confirmed = false
    var cancelled = false

    let on_ok = fn () { confirmed = true }
    let on_cancel = fn () { cancelled = true }

    let body_label = zoe.label("Deseja realmente excluir?")
    let diag = zoe.dialog("Confirmar Ação", [body_label], on_ok, on_cancel, {
            "width": 380.0,
            "height": 200.0,
            "confirm_text": "Sim",
            "cancel_text": "Não"
        })

    expect.equal(diag.tag, "dialog_card")
    expect.equal(diag.layout.width, 380.0)
    expect.equal(diag.layout.height, 200.0)
    expect.equal(diag.children.len(), 4)

    # Open dialog as modal overlay
    let ov_id = zoe.open_dialog("Alerta", [body_label], on_ok, on_cancel)
    expect.true (zoe.has_overlays())
    let top = zoe.get_top_overlay()
    expect.true (top.scrim)
    expect.false (top.dismissible)

    zoe.clear_overlays()
}
test("dropdown select with floating menu overlay") do {
    zoe.clear_overlays()
    let selected = zoe.use_state("Opção A")
    let dd = zoe.dropdown_select({
            "options": ["Opção A", "Opção B", "Opção C"],
            "selected": selected
        })

    expect.equal(dd.tag, "dropdown_select")
    expect.true (dd.props.has("on_click"))

    # Simulate click on dropdown to open menu overlay
    let click_handler = dd.props["on_click"]
    let fake_event = {
        "x": 100.0,
        "y": 100.0,
        "rect": { "x": 100.0, "y": 100.0, "width": 160.0, "height": 32.0 },
        "target_id": dd.id
    }
    (click_handler)(fake_event)

    expect.true (zoe.has_overlays())
    let top = zoe.get_top_overlay()
    expect.equal(top.element.tag, "dropdown_menu")
    expect.equal(top.element.children.len(), 3)
    # Check menu positioning right below trigger rect
    expect.equal(top.element.layout.x, 100.0)
    expect.equal(top.element.layout.y, 136.0)

    # Click on the 2nd option item
    let item2 = top.element.children[1]
    expect.equal(item2.tag, "dropdown_item")
    expect.true (item2.props.has("on_click"))
    (item2.props["on_click"])(fake_event)

    # Selection updated and overlay closed
    expect.equal(selected.get(), "Opção B")
    expect.false (zoe.has_overlays())
}
