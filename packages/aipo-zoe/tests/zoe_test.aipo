test("hierarchy_tree layout and semantic badges") do {
    let selected_sig = zoe.use_state("hero")
    let tree = zoe.hierarchy_tree({
            "selected": selected_sig,
            "nodes": [
            {
                "id": "root",
                "label": "RootScene",
                "type": "3d",
                "children": [
                { "id": "cam", "label": "MainCamera", "type": "camera" },
                { "id": "hero", "label": "Player", "type": "3d" }
                ]
            }
            ]
        })

    expect.equal(tree.tag, "hierarchy_tree")
    # Generates rows: RootScene (level 0), MainCamera (level 1), Player (level 1)
    expect.equal(tree.children.len(), 3)

    let root_row = tree.children[0]
    let cam_row = tree.children[1]
    let hero_row = tree.children[2]

    # Fitts's Law: 100% width on rows
    expect.equal(root_row.props["width"], "100%")
    expect.equal(cam_row.props["width"], "100%")
    expect.equal(hero_row.props["width"], "100%")

    # Selected row has surface_1 highlight
    expect.equal(hero_row.props["background"], zoe.color.surface_1)
    expect.equal(root_row.props["background"], zoe.color.transparent)

    # Clicking cam row selects it
    (cam_row.props["on_click"])({})
    expect.equal(selected_sig.get(), "cam")
}
