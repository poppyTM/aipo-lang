test("scrubber_input continuous drag and modifiers") do {
    let val_sig = zoe.use_state(50.0)
    let scrubber = zoe.scrubber_input({
            "label": "X",
            "label_color": zoe.color.peach,
            "value": val_sig,
            "step": 1.0,
            "min": 0.0,
            "max": 100.0
        })

    expect.equal(scrubber.tag, "scrubber_input")
    expect.true (scrubber.props.has("on_drag"))

    let on_drag = scrubber.props["on_drag"]

    # Normal drag: delta dx = 10.0 -> +2.0 (10.0 * 1.0 * 0.2)
    (on_drag)({ "dx": 10.0, "shift": false, "ctrl": false })
    expect.equal(val_sig.get(), 52.0)

    # Shift drag (micro precision 0.1x): delta dx = 10.0 -> +0.2
    (on_drag)({ "dx": 10.0, "shift": true, "ctrl": false })
    expect.equal(val_sig.get(), 52.2)

    # Ctrl drag (macro snap 10.0x): delta dx = 10.0 -> +20.0
    (on_drag)({ "dx": 10.0, "shift": false, "ctrl": true })
    expect.equal(val_sig.get(), 72.2)

    # Clamping at max: 100.0
    (on_drag)({ "dx": 200.0, "shift": false, "ctrl": false })
    expect.equal(val_sig.get(), 100.0)
}
test("segmented_group pill toggle and active elevation") do {
