# =========================================================================
# M13 REGRESSION SUITE
# Every test below locks in a defect fixed in the M13 wave. They are written
# to fail against the pre-M13 implementation.
# =========================================================================

test("M13: hex parser accepts every common notation") do {
    # 6-digit with and without the leading '#'
    let c6 = zoe.hex("#89b4fa")
    expect.approx(c6.r, 0.537, 0.01)
    expect.approx(c6.g, 0.706, 0.01)
    expect.approx(c6.b, 0.980, 0.01)
    expect.equal(c6.a, 1.0)

    let c6b = zoe.hex("89b4fa")
    expect.approx(c6b.r, c6.r, 0.0001)

    # 3-digit shorthand: each nibble is doubled ('f0a' -> 'ff00aa')
    let c3 = zoe.hex("#f0a")
    expect.equal(c3.r, 1.0)
    expect.equal(c3.g, 0.0)
    expect.approx(c3.b, 0.667, 0.01)

    # 8-digit with alpha
    let c8 = zoe.hex("#89b4fa80")
    expect.approx(c8.r, 0.537, 0.01)
    expect.approx(c8.a, 0.502, 0.01)

    # Uppercase is accepted
    let cu = zoe.hex("#89B4FA")
    expect.approx(cu.r, c6.r, 0.0001)
}
test("M13: hex parser returns transparent on invalid input, never gray") do {
    let bad1 = zoe.hex("#nothex")
    expect.equal(bad1.a, 0.0)
    let bad2 = zoe.hex("")
    expect.equal(bad2.a, 0.0)
    let bad3 = zoe.hex("#12345")
    expect.equal(bad3.a, 0.0)
    # The pre-M13 bug returned opaque gray (100,100,100) for these.
    expect.false (bad1.r == 0.392 and bad1.g == 0.392 and bad1.b == 0.392)
}
test("M13: color_to_hex round-trips through the parser") do {
    let c = zoe.hex("#89b4fa")
    let s = zoe.color_to_hex(c)
    expect.equal(s, "#89b4fa")
    let back = zoe.hex(s)
    expect.approx(back.r, c.r, 0.01)
    expect.approx(back.g, c.g, 0.01)
    expect.approx(back.b, c.b, 0.01)
}
test("M13: font_weight keywords resolve to numeric weights") do {
    expect.equal(zoe.resolve_weight("thin"), 100)
    expect.equal(zoe.resolve_weight("light"), 300)
    expect.equal(zoe.resolve_weight("normal"), 400)
    expect.equal(zoe.resolve_weight("regular"), 400)
    expect.equal(zoe.resolve_weight("medium"), 500)
    expect.equal(zoe.resolve_weight("semibold"), 600)
    expect.equal(zoe.resolve_weight("bold"), 700)
    expect.equal(zoe.resolve_weight("black"), 900)

    # Unknown values fall back to normal rather than failing.
    expect.equal(zoe.resolve_weight("nonsense"), 400)
    expect.equal(zoe.resolve_weight(none), 400)
    # Numbers pass through.
    expect.equal(zoe.resolve_weight(650), 650)
}
test("M13: bold text measures wider than regular at the same size") do {
    let regular = zoe.measure_text("Inspector", 14.0, 400)
    let bold = zoe.measure_text("Inspector", 14.0, 700)
    # The pre-M13 code returned the same width for both because the prop was
    # accepted and then ignored.
    expect.true (bold > regular)
}
test("M13: labels honor font_weight in intrinsic measurement") do {
    let plain = zoe.label("Scene", { "font_size": 14.0 })
    let bold = zoe.label("Scene", { "font_size": 14.0, "font_weight": "bold" })

    # Measure directly: the synthetic emboldening is intentionally sub-pixel
    # (0.35px per side at 14pt), so the delta is small but strictly positive.
    let w_plain = zoe.measure_text("Scene", 14.0, 400)
    let w_bold = zoe.measure_text("Scene", 14.0, "bold")
    expect.true (w_bold > w_plain)

    # An explicit `width: "auto"` selects the intrinsic path, so the resolved
    # box is exactly the measured advance. This is the width every auto-sized
    # parent, row distribution and button composition depends on.
    let auto_plain = zoe.label("Scene", { "font_size": 14.0, "width": "auto" })
    let auto_bold = zoe.label("Scene", { "font_size": 14.0, "width": "auto", "font_weight": "bold" })
    zoe.compute_layout(auto_plain, 400.0, 200.0)
    zoe.compute_layout(auto_bold, 400.0, 200.0)

    expect.approx(auto_plain.layout.width, w_plain, 0.01)
    expect.approx(auto_bold.layout.width, w_bold, 0.01)
    expect.true (auto_bold.layout.width > auto_plain.layout.width)
}
test("M13: spacer honors its flex weight") do {
    let s1 = zoe.spacer(1.0)
    let s3 = zoe.spacer(3.0)
    # flex > 1 emits a weighted dimension; the default keeps the bare spelling.
    expect.equal(s3.props["width"], "flex3.0")
    expect.equal(s1.props["width"], "flex")

    # Two spacers in a row split leftover space in proportion to their weight.
    # Note: the local must not be named `row`, which would shadow the
    # container constructor in this scope.
    let container = zoe.row({ "width": 400.0, "height": 40.0, "direction": "row" }, [
        zoe.label("A", { "width": 100.0 }),
        zoe.spacer(1.0),
        zoe.spacer(3.0)
        ])
    zoe.compute_layout(container, 400.0, 40.0)
    let one = container.children[1].layout.width
    let three = container.children[2].layout.width
    # 300px of leftover split 1:3 -> 75 and 225. Pre-M13 both received 150.
    expect.approx(one, 75.0, 1.0)
    expect.approx(three, 225.0, 1.0)
}
test("M13: runtime string table is overridable and resettable") do {
    expect.equal(zoe.str("dialog.confirm"), "Confirm")
    expect.equal(zoe.str("dialog.cancel"), "Cancel")

    zoe.set_strings({ "dialog.confirm": "Confirmar", "dialog.cancel": "Cancelar" })
    expect.equal(zoe.str("dialog.confirm"), "Confirmar")
    expect.equal(zoe.str("dialog.cancel"), "Cancelar")
    # Partial override leaves other keys untouched.
    expect.equal(zoe.str("dialog.close"), "Close")

    zoe.reset_strings()
    expect.equal(zoe.str("dialog.confirm"), "Confirm")
}
test("M13: ellipsize truncates to fit a width budget") do {
    let s = "RootScene3D with a very long descriptive name"
    let short = zoe.ellipsize(s, 80.0, 12.0, 400)
    expect.true (short.len() < s.len())
    expect.true (zoe.measure_text(short, 12.0, 400) <= 80.0)

    # Text that already fits is returned unchanged.
    let fits = zoe.ellipsize("OK", 200.0, 12.0, 400)
    expect.equal(fits, "OK")
    # A zero budget yields the ellipsis alone.
    expect.equal(zoe.ellipsize(s, 0.0, 12.0, 400), "")
}
test("M13: wrap_text breaks into multiple lines within max_lines") do {
    let s = "The quick brown fox jumps over the lazy dog repeatedly and often"
    let lines = zoe.wrap_text(s, 100.0, 12.0, 400, 3)
    expect.true (lines.len() > 1)
    expect.true (lines.len() <= 3)
    each line in lines {
        expect.true (zoe.measure_text(line, 12.0, 400) <= 130.0)
    }
}
test("M13: wrap_text breaks a single unbreakable token mid-word") do {
    let token = "Supercalifragilisticexpialidocious"
    let lines = zoe.wrap_text(token, 40.0, 12.0, 400, 4)
    expect.true (lines.len() > 1)
    each line in lines {
        expect.true (zoe.measure_text(line, 12.0, 400) <= 40.0)
    }
}
test("M13: slider exposes drag handlers and a thumb") do {
    let changed = []
    let sl = zoe.slider(50.0, 0.0, 100.0, fn (v) { changed.add(v) }, {})

    # A slider with no drag handler could not be scrubbed at all pre-M13.
    expect.true (sl.children[0].props.has("on_drag"))
    expect.true (sl.children[0].props.has("on_click"))

    # The thumb exists and is positioned proportionally to the value.
    let track = sl.children[0]
    var found_thumb = false
    each child in track.children {
        if child.tag == "slider_thumb" {
            found_thumb = true
        }
    }
    expect.true (found_thumb)
}
test("M13: retro3d trigonometry matches the standard library") do {
    # The pre-M13 polynomial approximations reached 4.22% error at cos(0.6),
    # which is the default orbit-camera yaw.
    let cam = zoe.camera_3d(0.6, 0.45, 240.0)
    let rect = { "x": 0.0, "y": 0.0, "width": 800.0, "height": 600.0 }
    let p = zoe.project_3d(0.0, 0.0, 0.0, cam, rect)

    # A point at the orbit target projects to the viewport center.
    expect.approx(p["x"], 400.0, 0.5)
    expect.approx(p["y"], 300.0, 0.5)
    expect.true (p["visible"])

    # Vector length uses a real square root.
    let v = zoe.vec3(3.0, 4.0, 0.0)
    let cube = zoe.cube_mesh(2.0, 2.0, 2.0)
    expect.true (cube["vertices"].len() == 8)
    expect.true (v["x"] == 3.0)
}
