# components.aipo — Standard Zoe UI component library for aipo.zoe
# Includes Button, Switch, Slider, ProgressBar, Card, and Badge

import types as types_mod
import color as color_mod
import elements as elements_mod
import hooks as hooks_mod
import overlay as overlay_mod
import leona as leona_mod
import icons as icons_mod
import strings as strings_mod
import tokens as tokens_mod

# Interactive clickable button
fn make_button(label_text: String, on_click = none, props: Dict = {}) {
    let variant = if props.has("variant") then props["variant"] else "primary"
            let width = if props.has("width") then props["width"] else "auto"
                    let height = if props.has("height") then props["height"] else 34.0
                            let font_size = if props.has("font_size") then props["font_size"] else 13.0

                                    var default_bg = color_mod.blue
                                    if variant == "danger" {
                                        default_bg = color_mod.red
                                    } elif variant == "secondary" {
                                        default_bg = color_mod.surface_1
                                    } elif variant == "ghost" {
                                        default_bg = color_mod.surface_0
                                    }

                                    let bg = if props.has("background") then props["background"] else default_bg
                                            let text_clr = if props.has("color") then props["color"] else color_mod.white

                                                    var btn_props = {
                                                        "tag": "button",
                                                        "direction": "row",
                                                        "align_items": "center",
                                                        "justify_content": "center",
                                                        "width": width,
                                                        "height": height,
                                                        "background": bg,
                                                        "border_radius": 6.0,
                                                        "border_width": 1.0,
                                                        "border_color": color_mod.surface_2,
                                                        "padding_x": 12.0,
                                                        "padding_y": 6.0,
                                                        "gap": 6.0,
                                                        "on_click": on_click
                                                    }
                                                    # M14: elevation prop is threaded through so the SDF shader draws a real
                                                    # soft shadow rather than the old hard offset rectangle.
                                                    if props.has("elevation") {
                                                        btn_props["elevation"] = props["elevation"]
                                                    }
                                                    if props.has("tooltip") {
                                                        btn_props["tooltip"] = props["tooltip"]
                                                    }
                                                    if props.has("focusable") {
                                                        btn_props["focusable"] = props["focusable"]
                                                    }

                                                    var btn_children = []
                                                    if props.has("icon") {
                                                        let icon_name = props["icon"]
                                                        let icon_sz = if props.has("icon_size") then (props["icon_size"] + 0.0) else (font_size + 2.0)
                                                                let icon_elem = icons_mod.icons_make_icon(icon_name, { "size": icon_sz, "color": text_clr })
                                                                btn_children.add(icon_elem)
                                                            }

                                                            if label_text != "" {
                                                                btn_children.add(elements_mod.make_label(label_text, {
                                                                        "font_size": font_size,
                                                                        "color": text_clr,
                                                                        "font_weight": "bold"
                                                                    }))
                                                            }

                                                            return elements_mod.make_rect(btn_props, btn_children)
                                                        }

                                                        # Toggle switch (On/Off)
                                                        fn make_switch(is_on: Bool, on_toggle, props: Dict) {
                                                            let width = if props.has("width") then props["width"] else 46.0
                                                                    let height = if props.has("height") then props["height"] else 24.0

                                                                            let bg = if is_on then color_mod.green else color_mod.surface_1
                                                                                    let knob_x = if is_on then 22.0 else 2.0

                                                                                            return elements_mod.make_rect(
                                                                                                {
                                                                                                    "tag": "switch",
                                                                                                    "width": width,
                                                                                                    "height": height,
                                                                                                    "background": bg,
                                                                                                    "border_radius": 12.0,
                                                                                                    "border_width": 1.0,
                                                                                                    "border_color": color_mod.surface_2,
                                                                                                    "padding": 2.0,
                                                                                                    "on_click": on_toggle
                                                                                                },
                                                                                                [
                                                                                                elements_mod.make_rect(
                                                                                                {
                                                                                                    "tag": "switch_knob",
                                                                                                    "width": 20.0,
                                                                                                    "height": 20.0,
                                                                                                    "offset_x": knob_x,
                                                                                                    "background": color_mod.white,
                                                                                                    "border_radius": 10.0
                                                                                                },
                                                                                                []
                                                                                                )
                                                                                                ]
                                                                                            )
                                                                                        }

                                                                                        # Range slider
                                                                                        #
                                                                                        # M13: the slider is now draggable. Previously it only exposed `on_click`, so
                                                                                        # the value could not be changed by dragging the thumb at all. Two interactions
                                                                                        # are supported, matching what every native slider does:
                                                                                        #
                                                                                        #   * press on the track  -> jump to that position
                                                                                        #   * press and drag      -> follow the pointer continuously
                                                                                        #
                                                                                        # `on_change` receives the numeric value. `on_drag_end` fires once when the
                                                                                        # gesture finishes, which is where an undo entry should be pushed.
                                                                                        fn make_slider(value: Float, min_val: Float, max_val: Float, on_change, props: Dict) {
                                                                                            let width = if props.has("width") then props["width"] else 180.0
                                                                                                    let height = if props.has("height") then props["height"] else 24.0
                                                                                                            let track_h = if props.has("track_height") then (props["track_height"] + 0.0) else 6.0
                                                                                                                    let thumb_size = if props.has("thumb_size") then (props["thumb_size"] + 0.0) else 14.0
                                                                                                                            let fill_color = if props.has("fill_color") then props["fill_color"] else color_mod.blue
                                                                                                                                    let track_color = if props.has("track_color") then props["track_color"] else color_mod.surface_0
                                                                                                                                            let step = if props.has("step") then (props["step"] + 0.0) else 0.0
                                                                                                                                                    let slider_id = types_mod.next_element_id()
                                                                                                                                                    var track_ref = { "element": none }

                                                                                                                                                    let diff = max_val - min_val
                                                                                                                                                    let ratio = if diff > 0.0 then (value - min_val) / diff else 0.0
                                                                                                                                                            let clamped_ratio = if ratio < 0.0 then 0.0 else (if ratio > 1.0 then 1.0 else ratio)
                                                                                                                                                                            # The fill stops at the thumb center so the thumb rides the fill edge.
                                                                                                                                                                            let thumb_x = (width + 0.0) * clamped_ratio

                                                                                                                                                                            # Maps a pointer x position (relative to the track) to a snapped value.
                                                                                                                                                                            let value_from_local_x = fn (local_x: Float) -> Float {
                                                                                                                                                                                let w = width + 0.0
                                                                                                                                                                                var t = if w > 0.0 then (local_x - (thumb_size / 2.0)) / w else 0.0
                                                                                                                                                                                        if t < 0.0 { t = 0.0 }
                                                                                                                                                                                        if t > 1.0 { t = 1.0 }
                                                                                                                                                                                        var out = min_val + t * diff
                                                                                                                                                                                        if step > 0.0 {
                                                                                                                                                                                            # Round to the nearest step, not truncate, so dragging feels even.
                                                                                                                                                                                            let raw_index = out / step
                                                                                                                                                                                            var idx = Int(raw_index)
                                                                                                                                                                                            if (raw_index - (idx + 0.0)) >= 0.5 { idx = idx + 1 }
                                                                                                                                                                                            out = (idx + 0) * step
                                                                                                                                                                                        }
                                                                                                                                                                                        if out < min_val { out = min_val }
                                                                                                                                                                                        if out > max_val { out = max_val }
                                                                                                                                                                                        return out
                                                                                                                                                                                    }

                                                                                                                                                                                    let emit_change = fn (local_x: Float) {
                                                                                                                                                                                        if on_change != none {
                                                                                                                                                                                            (on_change)(value_from_local_x(local_x))
                                                                                                                                                                                        }
                                                                                                                                                                                    }

                                                                                                                                                                                    let on_press = fn (e) {
                                                                                                                                                                                        let tr = track_ref["element"]
                                                                                                                                                                                        if tr == none or tr.layout == none {
                                                                                                                                                                                            return
                                                                                                                                                                                        }
                                                                                                                                                                                        emit_change((e["x"] + 0.0) - (tr.layout.x + 0.0))
                                                                                                                                                                                    }

                                                                                                                                                                                    let on_drag = fn (e) {
                                                                                                                                                                                        let tr = track_ref["element"]
                                                                                                                                                                                        if tr == none or tr.layout == none {
                                                                                                                                                                                            return
                                                                                                                                                                                        }
                                                                                                                                                                                        let dx = e["dx"] + 0.0
                                                                                                                                                                                        if dx == 0.0 {
                                                                                                                                                                                            return
                                                                                                                                                                                        }
                                                                                                                                                                                        emit_change((e["x"] + 0.0) - (tr.layout.x + 0.0))
                                                                                                                                                                                    }

                                                                                                                                                                                    var on_drag_end = none
                                                                                                                                                                                    if props.has("on_drag_end") {
                                                                                                                                                                                        on_drag_end = props["on_drag_end"]
                                                                                                                                                                                    }

                                                                                                                                                                                    let track_node = elements_mod.make_rect(
                                                                                                                                                                                        {
                                                                                                                                                                                            "tag": "slider_track",
                                                                                                                                                                                            "direction": "row",
                                                                                                                                                                                            "align_items": "center",
                                                                                                                                                                                            "width": width,
                                                                                                                                                                                            "height": height,
                                                                                                                                                                                            "on_click": on_press,
                                                                                                                                                                                            "on_drag": on_drag,
                                                                                                                                                                                            "on_drag_end": on_drag_end
                                                                                                                                                                                        },
                                                                                                                                                                                        [
                                                                                                                                                                                        elements_mod.make_rect(
                                                                                                                                                                                        {
                                                                                                                                                                                            "tag": "slider_rail",
                                                                                                                                                                                            "width": width,
                                                                                                                                                                                            "height": track_h,
                                                                                                                                                                                            "background": track_color,
                                                                                                                                                                                            "border_radius": track_h / 2.0
                                                                                                                                                                                        },
                                                                                                                                                                                        [
                                                                                                                                                                                        elements_mod.make_rect(
                                                                                                                                                                                        {
                                                                                                                                                                                            "tag": "slider_fill",
                                                                                                                                                                                            "width": thumb_x,
                                                                                                                                                                                            "height": track_h,
                                                                                                                                                                                            "background": fill_color,
                                                                                                                                                                                            "border_radius": track_h / 2.0
                                                                                                                                                                                        },
                                                                                                                                                                                        []
                                                                                                                                                                                        )
                                                                                                                                                                                        ]
                                                                                                                                                                                        ),
                                                                                                                                                                                        elements_mod.make_rect(
                                                                                                                                                                                        {
                                                                                                                                                                                            "tag": "slider_thumb",
                                                                                                                                                                                            "width": thumb_size,
                                                                                                                                                                                            "height": thumb_size,
                                                                                                                                                                                            "offset_x": thumb_x - (thumb_size / 2.0),
                                                                                                                                                                                            "background": color_mod.text,
                                                                                                                                                                                            "border_width": 2.0,
                                                                                                                                                                                            "border_color": fill_color,
                                                                                                                                                                                            "border_radius": thumb_size / 2.0
                                                                                                                                                                                        },
                                                                                                                                                                                        []
                                                                                                                                                                                        )
                                                                                                                                                                                        ]
                                                                                                                                                                                    )
                                                                                                                                                                                    track_ref["element"] = track_node

                                                                                                                                                                                    return elements_mod.make_rect(
                                                                                                                                                                                        {
                                                                                                                                                                                            "tag": "slider",
                                                                                                                                                                                            "id": slider_id,
                                                                                                                                                                                            "direction": "row",
                                                                                                                                                                                            "align_items": "center",
                                                                                                                                                                                            "width": width,
                                                                                                                                                                                            "height": height
                                                                                                                                                                                        },
                                                                                                                                                                                        [track_node]
                                                                                                                                                                                    )
                                                                                                                                                                                }

                                                                                                                                                                                # Progress bar
                                                                                                                                                                                fn make_progress_bar(progress: Float, props: Dict) {
                                                                                                                                                                                    let width = if props.has("width") then props["width"] else 200.0
                                                                                                                                                                                            let height = if props.has("height") then props["height"] else 10.0
                                                                                                                                                                                                    let fill_color = if props.has("color") then props["color"] else color_mod.blue

                                                                                                                                                                                                            let p = if progress < 0.0 then 0.0 else (if progress > 1.0 then 1.0 else progress)
                                                                                                                                                                                                                            let fill_w = (width + 0.0) * p

                                                                                                                                                                                                                            return elements_mod.make_rect(
                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                    "tag": "progress_bar",
                                                                                                                                                                                                                                    "width": width,
                                                                                                                                                                                                                                    "height": height,
                                                                                                                                                                                                                                    "background": color_mod.surface_0,
                                                                                                                                                                                                                                    "border_radius": (height + 0.0) / 2.0
                                                                                                                                                                                                                                },
                                                                                                                                                                                                                                [
                                                                                                                                                                                                                                elements_mod.make_rect(
                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                    "tag": "progress_fill",
                                                                                                                                                                                                                                    "width": fill_w,
                                                                                                                                                                                                                                    "height": height,
                                                                                                                                                                                                                                    "background": fill_color,
                                                                                                                                                                                                                                    "border_radius": (height + 0.0) / 2.0
                                                                                                                                                                                                                                },
                                                                                                                                                                                                                                []
                                                                                                                                                                                                                                )
                                                                                                                                                                                                                                ]
                                                                                                                                                                                                                            )
                                                                                                                                                                                                                        }

                                                                                                                                                                                                                        # Elevated card surface
                                                                                                                                                                                                                        fn make_card(props: Dict, children: List) {
                                                                                                                                                                                                                            let width = if props.has("width") then props["width"] else "100%"
                                                                                                                                                                                                                                    let height = if props.has("height") then props["height"] else "auto"
                                                                                                                                                                                                                                            let padding = if props.has("padding") then props["padding"] else 16.0
                                                                                                                                                                                                                                                    let gap = if props.has("gap") then props["gap"] else 12.0
                                                                                                                                                                                                                                                            let bg = if props.has("background") then props["background"] else color_mod.base
                                                                                                                                                                                                                                                                    let border_color = if props.has("border_color") then props["border_color"] else color_mod.surface_0
                                                                                                                                                                                                                                                                            let direction = if props.has("direction") then props["direction"] else "column"

                                                                                                                                                                                                                                                                                    props["tag"] = "card"
                                                                                                                                                                                                                                                                                    props["direction"] = direction
                                                                                                                                                                                                                                                                                    props["width"] = width
                                                                                                                                                                                                                                                                                    props["height"] = height
                                                                                                                                                                                                                                                                                    props["padding"] = padding
                                                                                                                                                                                                                                                                                    props["gap"] = gap
                                                                                                                                                                                                                                                                                    props["background"] = bg
                                                                                                                                                                                                                                                                                    props["border_radius"] = 12.0
                                                                                                                                                                                                                                                                                    props["border_width"] = 1.0
                                                                                                                                                                                                                                                                                    props["border_color"] = border_color
                                                                                                                                                                                                                                                                                    # M14: cards sit one elevation step above the surface, which is what makes
                                                                                                                                                                                                                                                                                    # them read as raised rather than as a flat lighter rectangle.
                                                                                                                                                                                                                                                                                    if not props.has("elevation") {
                                                                                                                                                                                                                                                                                        props["elevation"] = tokens_mod.elevation_sm
                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                    return elements_mod.make_rect(props, children)
                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                # Badge tag
                                                                                                                                                                                                                                                                                fn make_badge(text: String, props: Dict) {
                                                                                                                                                                                                                                                                                    let bg = if props.has("background") then props["background"] else color_mod.surface_1
                                                                                                                                                                                                                                                                                            let text_clr = if props.has("color") then props["color"] else color_mod.text

                                                                                                                                                                                                                                                                                                    return elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                            "tag": "badge",
                                                                                                                                                                                                                                                                                                            "direction": "row",
                                                                                                                                                                                                                                                                                                            "align_items": "center",
                                                                                                                                                                                                                                                                                                            "justify_content": "center",
                                                                                                                                                                                                                                                                                                            "background": bg,
                                                                                                                                                                                                                                                                                                            "border_radius": 10.0,
                                                                                                                                                                                                                                                                                                            "padding_x": 10.0,
                                                                                                                                                                                                                                                                                                            "padding_y": 4.0
                                                                                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                                                                                                        [
                                                                                                                                                                                                                                                                                                        elements_mod.make_label(text, {
                                                                                                                                                                                                                                                                                                            "font_size": 12.0,
                                                                                                                                                                                                                                                                                                            "color": text_clr,
                                                                                                                                                                                                                                                                                                            "font_weight": "bold"
                                                                                                                                                                                                                                                                                                        })
                                                                                                                                                                                                                                                                                                        ]
                                                                                                                                                                                                                                                                                                    )
                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                # Resizable Split View Container (horizontal or vertical with draggable handle)
                                                                                                                                                                                                                                                                                                fn make_split_view(arg1, arg2, arg3 = none) {
                                                                                                                                                                                                                                                                                                    var props = {}
                                                                                                                                                                                                                                                                                                    var first_child = none
                                                                                                                                                                                                                                                                                                    var second_child = none

                                                                                                                                                                                                                                                                                                    if arg3 == none {
                                                                                                                                                                                                                                                                                                        if (arg1 is List) {
                                                                                                                                                                                                                                                                                                            props = {}
                                                                                                                                                                                                                                                                                                            first_child = arg1[0]
                                                                                                                                                                                                                                                                                                            second_child = arg1[1]
                                                                                                                                                                                                                                                                                                        } elif (arg2 is List) {
                                                                                                                                                                                                                                                                                                            props = arg1
                                                                                                                                                                                                                                                                                                            first_child = arg2[0]
                                                                                                                                                                                                                                                                                                            second_child = arg2[1]
                                                                                                                                                                                                                                                                                                        } else {
                                                                                                                                                                                                                                                                                                            props = {}
                                                                                                                                                                                                                                                                                                            first_child = arg1
                                                                                                                                                                                                                                                                                                            second_child = arg2
                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                    } else {
                                                                                                                                                                                                                                                                                                        props = arg1
                                                                                                                                                                                                                                                                                                        first_child = arg2
                                                                                                                                                                                                                                                                                                        second_child = arg3
                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                    let direction = if props.has("direction") then props["direction"] else "horizontal"
                                                                                                                                                                                                                                                                                                            let split_prop = if props.has("split") then props["split"] else 0.5
                                                                                                                                                                                                                                                                                                                    let min_first = if props.has("min_first") then (props["min_first"] + 0.0) else 50.0
                                                                                                                                                                                                                                                                                                                            let min_second = if props.has("min_second") then (props["min_second"] + 0.0) else 50.0
                                                                                                                                                                                                                                                                                                                                    let handle_size = if props.has("handle_size") then (props["handle_size"] + 0.0) else 6.0
                                                                                                                                                                                                                                                                                                                                            let handle_color = if props.has("handle_color") then props["handle_color"] else color_mod.surface_0
                                                                                                                                                                                                                                                                                                                                                    let width_val = if props.has("width") then props["width"] else "100%"
                                                                                                                                                                                                                                                                                                                                                            let height_val = if props.has("height") then props["height"] else "100%"

                                                                                                                                                                                                                                                                                                                                                                    let ratio = if (split_prop is Float or split_prop is Int) then (split_prop + 0.0) else (split_prop.get() + 0.0)
                                                                                                                                                                                                                                                                                                                                                                            let clamped_ratio = if ratio < 0.01 then 0.01 else (if ratio > 0.99 then 0.99 else ratio)

                                                                                                                                                                                                                                                                                                                                                                                            var container_ref = { "element": none }
                                                                                                                                                                                                                                                                                                                                                                                            var container = none

                                                                                                                                                                                                                                                                                                                                                                                            let drag_handler = fn (e) {
                                                                                                                                                                                                                                                                                                                                                                                                let container = container_ref["element"]
                                                                                                                                                                                                                                                                                                                                                                                                if container == none or container.layout == none {
                                                                                                                                                                                                                                                                                                                                                                                                    return
                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                if direction == "horizontal" {
                                                                                                                                                                                                                                                                                                                                                                                                    let total_w = container.layout.width
                                                                                                                                                                                                                                                                                                                                                                                                    if total_w <= 0.0 {
                                                                                                                                                                                                                                                                                                                                                                                                        return
                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                    let local_x = e["x"] - container.layout.x
                                                                                                                                                                                                                                                                                                                                                                                                    let new_ratio = local_x / total_w
                                                                                                                                                                                                                                                                                                                                                                                                    let min_r = min_first / total_w
                                                                                                                                                                                                                                                                                                                                                                                                    let max_r = 1.0 - (min_second / total_w)
                                                                                                                                                                                                                                                                                                                                                                                                    let clamped = if new_ratio < min_r then min_r else (if new_ratio > max_r then max_r else new_ratio)
                                                                                                                                                                                                                                                                                                                                                                                                                    if not (split_prop is Float or split_prop is Int) {
                                                                                                                                                                                                                                                                                                                                                                                                                        hooks_mod.signal_set_value(split_prop, clamped)
                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                    if props.has("on_change") {
                                                                                                                                                                                                                                                                                                                                                                                                                        (props["on_change"])(clamped)
                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                } else {
                                                                                                                                                                                                                                                                                                                                                                                                                    let total_h = container.layout.height
                                                                                                                                                                                                                                                                                                                                                                                                                    if total_h <= 0.0 {
                                                                                                                                                                                                                                                                                                                                                                                                                        return
                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                    let local_y = e["y"] - container.layout.y
                                                                                                                                                                                                                                                                                                                                                                                                                    let new_ratio = local_y / total_h
                                                                                                                                                                                                                                                                                                                                                                                                                    let min_r = min_first / total_h
                                                                                                                                                                                                                                                                                                                                                                                                                    let max_r = 1.0 - (min_second / total_h)
                                                                                                                                                                                                                                                                                                                                                                                                                    let clamped = if new_ratio < min_r then min_r else (if new_ratio > max_r then max_r else new_ratio)
                                                                                                                                                                                                                                                                                                                                                                                                                                    if not (split_prop is Float or split_prop is Int) {
                                                                                                                                                                                                                                                                                                                                                                                                                                        hooks_mod.signal_set_value(split_prop, clamped)
                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                    if props.has("on_change") {
                                                                                                                                                                                                                                                                                                                                                                                                                                        (props["on_change"])(clamped)
                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                            if direction == "horizontal" {
                                                                                                                                                                                                                                                                                                                                                                                                                                let first_pct = clamped_ratio * 100.0
                                                                                                                                                                                                                                                                                                                                                                                                                                let first_wrapper = elements_mod.make_rect({
                                                                                                                                                                                                                                                                                                                                                                                                                                        "tag": "split_first",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "width": f"{first_pct}%",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "height": "100%"
                                                                                                                                                                                                                                                                                                                                                                                                                                    }, [first_child])

                                                                                                                                                                                                                                                                                                                                                                                                                                let handle_node = elements_mod.make_rect({
                                                                                                                                                                                                                                                                                                                                                                                                                                        "tag": "split_handle",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "justify_content": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "width": handle_size,
                                                                                                                                                                                                                                                                                                                                                                                                                                        "height": "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "background": handle_color,
                                                                                                                                                                                                                                                                                                                                                                                                                                        "on_drag": drag_handler
                                                                                                                                                                                                                                                                                                                                                                                                                                    }, [
                                                                                                                                                                                                                                                                                                                                                                                                                                    elements_mod.make_rect({
                                                                                                                                                                                                                                                                                                                                                                                                                                        "width": 2.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                        "height": 28.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                        "background": color_mod.overlay_0,
                                                                                                                                                                                                                                                                                                                                                                                                                                        "border_radius": 1.0
                                                                                                                                                                                                                                                                                                                                                                                                                                    }, [])
                                                                                                                                                                                                                                                                                                                                                                                                                                    ])

                                                                                                                                                                                                                                                                                                                                                                                                                                let second_wrapper = elements_mod.make_rect({
                                                                                                                                                                                                                                                                                                                                                                                                                                        "tag": "split_second",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "width": "flex",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "height": "100%"
                                                                                                                                                                                                                                                                                                                                                                                                                                    }, [second_child])

                                                                                                                                                                                                                                                                                                                                                                                                                                container = elements_mod.make_rect({
                                                                                                                                                                                                                                                                                                                                                                                                                                        "tag": "split_view",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "width": width_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                        "height": height_val
                                                                                                                                                                                                                                                                                                                                                                                                                                    }, [first_wrapper, handle_node, second_wrapper])
                                                                                                                                                                                                                                                                                                                                                                                                                            } else {
                                                                                                                                                                                                                                                                                                                                                                                                                                let first_pct = clamped_ratio * 100.0
                                                                                                                                                                                                                                                                                                                                                                                                                                let first_wrapper = elements_mod.make_rect({
                                                                                                                                                                                                                                                                                                                                                                                                                                        "tag": "split_first",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "width": "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "height": f"{first_pct}%"
                                                                                                                                                                                                                                                                                                                                                                                                                                    }, [first_child])

                                                                                                                                                                                                                                                                                                                                                                                                                                let handle_node = elements_mod.make_rect({
                                                                                                                                                                                                                                                                                                                                                                                                                                        "tag": "split_handle",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "justify_content": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "width": "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "height": handle_size,
                                                                                                                                                                                                                                                                                                                                                                                                                                        "background": handle_color,
                                                                                                                                                                                                                                                                                                                                                                                                                                        "on_drag": drag_handler
                                                                                                                                                                                                                                                                                                                                                                                                                                    }, [
                                                                                                                                                                                                                                                                                                                                                                                                                                    elements_mod.make_rect({
                                                                                                                                                                                                                                                                                                                                                                                                                                        "width": 28.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                        "height": 2.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                        "background": color_mod.overlay_0,
                                                                                                                                                                                                                                                                                                                                                                                                                                        "border_radius": 1.0
                                                                                                                                                                                                                                                                                                                                                                                                                                    }, [])
                                                                                                                                                                                                                                                                                                                                                                                                                                    ])

                                                                                                                                                                                                                                                                                                                                                                                                                                let second_wrapper = elements_mod.make_rect({
                                                                                                                                                                                                                                                                                                                                                                                                                                        "tag": "split_second",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "width": "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "height": "flex"
                                                                                                                                                                                                                                                                                                                                                                                                                                    }, [second_child])

                                                                                                                                                                                                                                                                                                                                                                                                                                container = elements_mod.make_rect({
                                                                                                                                                                                                                                                                                                                                                                                                                                        "tag": "split_view",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                        "width": width_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                        "height": height_val
                                                                                                                                                                                                                                                                                                                                                                                                                                    }, [first_wrapper, handle_node, second_wrapper])
                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                            container_ref["element"] = container
                                                                                                                                                                                                                                                                                                                                                                                                                            return container
                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                        # Tab bar component
                                                                                                                                                                                                                                                                                                                                                                                                                        fn make_tab_bar(props: Dict) {
                                                                                                                                                                                                                                                                                                                                                                                                                            let active_prop = if props.has("active") then props["active"] else ""
                                                                                                                                                                                                                                                                                                                                                                                                                                    let tabs = if props.has("tabs") then props["tabs"] else []
                                                                                                                                                                                                                                                                                                                                                                                                                                            let height = if props.has("height") then (props["height"] + 0.0) else 34.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                    let bg = if props.has("background") then props["background"] else color_mod.mantle
                                                                                                                                                                                                                                                                                                                                                                                                                                                            let active_color = if props.has("active_color") then props["active_color"] else color_mod.blue
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let cur_active = if (active_prop is String) then active_prop else (active_prop.get() + "")

                                                                                                                                                                                                                                                                                                                                                                                                                                                                            var tab_items = []
                                                                                                                                                                                                                                                                                                                                                                                                                                                                            each tab in tabs {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                var tab_id = ""
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                var tab_label = ""
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if (tab is Dict) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    tab_id = if tab.has("id") then tab["id"] else ""
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            tab_label = if tab.has("label") then tab["label"] else tab_id
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                } else {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    tab_id = f"{tab}"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    tab_label = tab_id
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let is_selected = (tab_id == cur_active)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let tab_bg = if is_selected then color_mod.base else color_mod.mantle
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let text_color = if is_selected then color_mod.text else color_mod.subtext

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let click_handler = fn (e) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if not (active_prop is String) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        hooks_mod.signal_set_value(active_prop, tab_id)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if props.has("on_change") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        (props["on_change"])(tab_id)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # Tab button container
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                var children = [
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    elements_mod.make_label(tab_label, {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "font_size": 13.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "color": text_color,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "font_weight": if is_selected then "bold" else "normal"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            })
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ]

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        # Active indicator line at bottom of tab
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if is_selected {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            children.add(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                elements_mod.make_rect({
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "tag": "tab_indicator",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "width": "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "height": 2.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "background": active_color
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }, [])
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let item = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "tag": "tab_item",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "justify_content": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "height": height,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "padding_x": 16.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "background": tab_bg,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "on_click": click_handler
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            children
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        tab_items.add(item)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "tab_bar",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": if props.has("width") then props["width"] else "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "height": height,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "background": bg,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "border_width": 1.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "border_color": color_mod.surface_0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "gap": 2.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                tab_items
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        # High-level Tab View component (tab_bar + active content view)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        fn make_tab_view(props: Dict, views: Dict) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let tabs_list = if props.has("tabs") then props["tabs"] else views.keys()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    var default_active = ""
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if tabs_list.len() > 0 {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let first = tabs_list[0]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if (first is Dict) and first.has("id") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let id_val = first["id"]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            default_active = f"{id_val}"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        } else {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            default_active = f"{first}"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let active_prop = if props.has("active") and props["active"] != "" then props["active"] else default_active
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let cur_active = if (active_prop is String) then active_prop else (active_prop.get() + "")

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let bar_props = {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "active": active_prop,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "tabs": tabs_list,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "height": if props.has("bar_height") then props["bar_height"] else 34.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "active_color": if props.has("active_color") then props["active_color"] else color_mod.blue
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if props.has("tab_bar_background") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        bar_props["background"] = props["tab_bar_background"]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let tab_bar_node = make_tab_bar(bar_props)

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    var content_node = elements_mod.make_rect({
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "tab_empty",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "height": "flex"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }, [])

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if views.has(cur_active) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let child = views[cur_active]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        content_node = elements_mod.make_rect({
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "tag": "tab_content",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "width": "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "height": "flex"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }, [child])
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "tab_view",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": if props.has("width") then props["width"] else "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "height": if props.has("height") then props["height"] else "100%"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        [tab_bar_node, content_node]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # Scrollable View Component with Clipping and Interactive Scrollbar
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                fn make_scroll_view(arg1, arg2 = none) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    var props = {}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    var children = []

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if arg2 == none {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if (arg1 is List) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            props = {}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            children = arg1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        } else {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            props = arg1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            children = []
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    } else {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        props = arg1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        children = arg2
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let scroll_y_prop = if props.has("scroll_y") then props["scroll_y"] else 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let current_scroll = if (scroll_y_prop is Float or scroll_y_prop is Int) then (scroll_y_prop + 0.0) else (scroll_y_prop.get() + 0.0)

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let width_val = if props.has("width") then props["width"] else "100%"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let height_val = if props.has("height") then props["height"] else "100%"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let show_scrollbar = if props.has("show_scrollbar") then props["show_scrollbar"] else true
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let scrollbar_width = if props.has("scrollbar_width") then (props["scrollbar_width"] + 0.0) else 6.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let pad = if props.has("padding") then (props["padding"] + 0.0) else 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let gap_val = if props.has("gap") then (props["gap"] + 0.0) else 4.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let scroll_speed = if props.has("scroll_speed") then (props["scroll_speed"] + 0.0) else 30.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let bg = if props.has("background") then props["background"] else none

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # M13: upper clamp. Previously only the lower bound was enforced, so a
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # short list inside a tall container scrolled forever into empty space.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # `max_scroll` is the scrollable extent; it is measured during layout and
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # stored back on the element, because the content height is not known until
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # after Leona runs. Applications may also pass it explicitly.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # Carried across rebuilds: Leona writes the measured overflow back into
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # props on the previous element, and the same props dict is reused as the
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # starting point for this build.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    var max_scroll = 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if props.has("max_scroll") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        max_scroll = props["max_scroll"] + 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if max_scroll < 0.0 {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        max_scroll = 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # M13: clamp to the measured overflow, but only once an overflow is known.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # On the very first layout pass there is no measurement yet, so an explicit
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # initial `scroll_y` must pass through untouched or restoring a saved
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # scroll position would be impossible.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let has_measurement = props.has("max_scroll")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    var clamped_scroll = current_scroll
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if has_measurement and current_scroll < 0.0 {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        clamped_scroll = 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    } elif has_measurement and current_scroll > max_scroll {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        clamped_scroll = max_scroll
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    var scroll_container_ref = { "element": none }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let wheel_handler = fn (e) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let cur = if (scroll_y_prop is Float or scroll_y_prop is Int) then (scroll_y_prop + 0.0) else (scroll_y_prop.get() + 0.0)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let delta = (e["wheel_y"] + 0.0) * scroll_speed
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let new_s = cur - delta
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # The lower bound always applies. The upper bound requires a measured
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # overflow: without one there is no evidence the content fits, so
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # scrolling further is correct rather than being silently swallowed.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                var clamped = new_s
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if clamped < 0.0 { clamped = 0.0 }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if has_measurement and clamped > max_scroll { clamped = max_scroll }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if not (scroll_y_prop is Float or scroll_y_prop is Int) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    hooks_mod.signal_set_value(scroll_y_prop, clamped)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if props.has("on_scroll") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    (props["on_scroll"])(clamped)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            # Dragging the thumb must move the content proportionally, matching the
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            # native convention: content delta / track length = scroll delta / scrollable
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            # range. The previous fixed 3.0 multiplier made the thumb speed depend on
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            # the scroll range, which felt wrong for long lists.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let thumb_drag = fn (e) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let container = scroll_container_ref["element"]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if container == none or container.layout == none {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let dy = e["dy"] + 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if dy == 0.0 {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let track_h = container.layout.height
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if track_h <= 0.0 or max_scroll <= 0.0 {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # `max_scroll` is the content overflow; the thumb travels the track
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # minus its own height, so divide by that span.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let span = track_h - scrollbar_width
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if span <= 0.0 {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let ratio = dy / span
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let cur = if (scroll_y_prop is Float or scroll_y_prop is Int) then (scroll_y_prop + 0.0) else (scroll_y_prop.get() + 0.0)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        var clamped = cur + ratio * max_scroll
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if clamped < 0.0 { clamped = 0.0 }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if clamped > max_scroll { clamped = max_scroll }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if not (scroll_y_prop is Float or scroll_y_prop is Int) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            hooks_mod.signal_set_value(scroll_y_prop, clamped)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if props.has("on_scroll") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            (props["on_scroll"])(clamped)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let content_column = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "scroll_content",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "offset_y": -clamped_scroll,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "padding": pad,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "gap": gap_val
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        children
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let viewport_rect = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "scroll_viewport",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": if show_scrollbar then "flex" else "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "height": "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "clip": true
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                [content_column]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            )

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            var root_items = [viewport_rect]

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if show_scrollbar {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # M13: the thumb reflects the visible fraction of the content and sits
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # at the scroll position, instead of being a fixed 40px block pinned to
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # the top of the track.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let viewport_h = if (height_val is Float or height_val is Int) then (height_val + 0.0) else 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        var content_h = if props.has("content_height") then (props["content_height"] + 0.0) else 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if content_h <= 0.0 {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    content_h = viewport_h + max_scroll
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                var thumb_h = 40.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                var thumb_y = 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if viewport_h > 0.0 and content_h > 0.0 and content_h > viewport_h {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let frac = viewport_h / content_h
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    thumb_h = math.max(24.0, viewport_h * frac)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let span = viewport_h - thumb_h
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let pos = if max_scroll > 0.0 then (clamped_scroll / max_scroll) else 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            thumb_y = span * pos
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        } elif viewport_h > 0.0 {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            thumb_h = viewport_h
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let thumb_node = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "tag": "scrollbar_thumb",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "width": scrollbar_width,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "height": thumb_h,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "offset_y": thumb_y,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "background": color_mod.surface_2,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "border_radius": scrollbar_width / 2.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "on_drag": thumb_drag
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            []
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        )

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let track_node = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "tag": "scrollbar_track",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "width": scrollbar_width,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "height": "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "background": color_mod.surface_0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            [thumb_node]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        root_items.add(track_node)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    var container_props = {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "tag": "scroll_view",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "width": width_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "height": height_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "clip": true,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "on_wheel": wheel_handler
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if bg != none {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        container_props["background"] = bg
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let container = elements_mod.make_rect(container_props, root_items)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    scroll_container_ref["element"] = container
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return container
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # Native Integrated Sub-rect Viewport for 2D/3D scenes, retro games and engine editors
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                fn make_viewport(props: Dict, children: List) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let width_val = if props.has("width") then props["width"] else "flex"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let height_val = if props.has("height") then props["height"] else "flex"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let bg = if props.has("background") then props["background"] else color_mod.crust
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let bw = if props.has("border_width") then (props["border_width"] + 0.0) else 1.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let bc = if props.has("border_color") then props["border_color"] else color_mod.surface_0

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            var node_props = {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "tag": "viewport",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "width": width_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "height": height_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "background": bg,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "border_width": bw,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "border_color": bc,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "clip": true
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if props.has("on_render") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                node_props["on_render"] = props["on_render"]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if props.has("on_drag") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                node_props["on_drag"] = props["on_drag"]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if props.has("on_drag_end") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                node_props["on_drag_end"] = props["on_drag_end"]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if props.has("on_wheel") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                node_props["on_wheel"] = props["on_wheel"]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if props.has("on_click") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                node_props["on_click"] = props["on_click"]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if props.has("id") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                node_props["id"] = props["id"]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return elements_mod.make_rect(node_props, children)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        # Translates window screen coordinates to viewport world coordinates given camera target and zoom
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        fn calc_screen_to_world(rect: Dict, screen_x: Float, screen_y: Float, cam_x: Float, cam_y: Float, zoom: Float) -> Dict {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let local_x = (screen_x + 0.0) - (rect["x"] + 0.0)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let local_y = (screen_y + 0.0) - (rect["y"] + 0.0)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let z = if zoom > 0.001 then zoom else 1.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let world_x = (cam_x + 0.0) + (local_x - (rect["width"] + 0.0) / 2.0) / z
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let world_y = (cam_y + 0.0) + (local_y - (rect["height"] + 0.0) / 2.0) / z
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "x": world_x,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "y": world_y
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # Translates viewport world coordinates to window screen coordinates given camera target and zoom
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                fn calc_world_to_screen(rect: Dict, world_x: Float, world_y: Float, cam_x: Float, cam_y: Float, zoom: Float) -> Dict {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let z = if zoom > 0.001 then zoom else 1.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let local_x = ((world_x + 0.0) - (cam_x + 0.0)) * z + (rect["width"] + 0.0) / 2.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let local_y = ((world_y + 0.0) - (cam_y + 0.0)) * z + (rect["height"] + 0.0) / 2.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "x": (rect["x"] + 0.0) + local_x,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "y": (rect["y"] + 0.0) + local_y
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        # Helper to test if a point (px, py) is inside a bounding box (rx, ry, rw, rh)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        fn is_point_in_rect(px: Float, py: Float, rx: Float, ry: Float, rw: Float, rh: Float) -> Bool {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return (px + 0.0) >= (rx + 0.0) and (px + 0.0) <= ((rx + 0.0) + (rw + 0.0)) and (py + 0.0) >= (ry + 0.0) and (py + 0.0) <= ((ry + 0.0) + (rh + 0.0))
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        # Tests hit on a 2D transform gizmo located at screen position (gx, gy)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        # Returns "center", "x", "y", or "none"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        fn calc_gizmo_hit(mx: Float, my: Float, gx: Float, gy: Float, size: Float = 45.0) -> String {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let cr = 8.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            # 1. Center handle (box around gx, gy)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if (mx + 0.0) >= ((gx + 0.0) - cr) and (mx + 0.0) <= ((gx + 0.0) + cr) and (my + 0.0) >= ((gy + 0.0) - cr) and (my + 0.0) <= ((gy + 0.0) + cr) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                return "center"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            # 2. X axis handle (horizontal line to the right: gx to gx + size)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if (mx + 0.0) >= (gx + 0.0) and (mx + 0.0) <= ((gx + 0.0) + (size + 0.0) + 8.0) and (my + 0.0) >= ((gy + 0.0) - 7.0) and (my + 0.0) <= ((gy + 0.0) + 7.0) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                return "x"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            # 3. Y axis handle (vertical line upwards: gy - size to gy)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if (mx + 0.0) >= ((gx + 0.0) - 7.0) and (mx + 0.0) <= ((gx + 0.0) + 7.0) and (my + 0.0) >= ((gy + 0.0) - (size + 0.0) - 8.0) and (my + 0.0) <= (gy + 0.0) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                return "y"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return "none"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        # Renders a 2D transform gizmo with X and Y axes, handles, and active highlight
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        fn render_gizmo_2d(gx: Float, gy: Float, size: Float = 45.0, active_axis: String = "none") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let x_color_r = if active_axis == "x" then 1.0 else 0.95
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let x_color_g = if active_axis == "x" then 0.9 else 0.4
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let x_color_b = if active_axis == "x" then 0.4 else 0.4

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let y_color_r = if active_axis == "y" then 0.7 else 0.4
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let y_color_g = if active_axis == "y" then 1.0 else 0.9
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let y_color_b = if active_axis == "y" then 0.7 else 0.4

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let center_color_r = if active_axis == "center" then 1.0 else 0.8
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let center_color_g = if active_axis == "center" then 1.0 else 0.85
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let center_color_b = if active_axis == "center" then 0.4 else 0.95

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # X axis shaft
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    host_draw_line(gx + 0.0, gy + 0.0, (gx + 0.0) + (size + 0.0), gy + 0.0, 2.5, x_color_r, x_color_g, x_color_b, 1.0)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # X arrowhead (square/arrow handle at tip)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    host_draw_rect((gx + 0.0) + (size + 0.0) - 2.0, (gy + 0.0) - 4.0, 8.0, 8.0, x_color_r, x_color_g, x_color_b, 1.0)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    host_draw_text("X", (gx + 0.0) + (size + 0.0) + 8.0, (gy + 0.0) - 4.0, 11.0, x_color_r, x_color_g, x_color_b)

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # Y axis shaft (pointing up in viewport: -Y)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    host_draw_line(gx + 0.0, gy + 0.0, gx + 0.0, (gy + 0.0) - (size + 0.0), 2.5, y_color_r, y_color_g, y_color_b, 1.0)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # Y arrowhead (square/arrow handle at tip)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    host_draw_rect((gx + 0.0) - 4.0, (gy + 0.0) - (size + 0.0) - 6.0, 8.0, 8.0, y_color_r, y_color_g, y_color_b, 1.0)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    host_draw_text("Y", (gx + 0.0) - 4.0, (gy + 0.0) - (size + 0.0) - 16.0, 11.0, y_color_r, y_color_g, y_color_b)

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # Center handle (free translation)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    host_draw_rect((gx + 0.0) - 5.0, (gy + 0.0) - 5.0, 10.0, 10.0, center_color_r, center_color_g, center_color_b, 1.0)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    host_draw_rect_lines((gx + 0.0) - 5.0, (gy + 0.0) - 5.0, 10.0, 10.0, 1.0, 0.1, 0.1, 0.15, 0.8)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # Configures the GPU camera viewport and scissor sub-rect for the active viewport
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                fn apply_viewport_camera(rect: Dict, target_x: Float, target_y: Float, zoom: Float) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let vx = rect["x"] + 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let vy = rect["y"] + 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let vw = rect["width"] + 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let vh = rect["height"] + 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let tx = target_x + 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let ty = target_y + 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let z = if zoom > 0.001 then zoom else 1.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            host_set_viewport_camera(vx, vy, vw, vh, tx, ty, z)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        # Text input component with cursor and keyboard entry
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        fn make_text_input(props: Dict = {}) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let value_prop = if props.has("value") then props["value"] else ""
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let placeholder = if props.has("placeholder") then props["placeholder"] else "..."
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let width_val = if props.has("width") then props["width"] else "100%"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let height_val = if props.has("height") then props["height"] else 34.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let font_size = if props.has("font_size") then (props["font_size"] + 0.0) else 13.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let bg = if props.has("background") then props["background"] else color_mod.mantle
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let border_color = if props.has("border_color") then props["border_color"] else color_mod.surface_1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let border_width = if props.has("border_width") then (props["border_width"] + 0.0) else 1.0

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let cur_str = if (value_prop is String) then value_prop else (if value_prop != none then (value_prop.get() + "") else "")

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let on_char_handler = fn (ch) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if ch == "\n" or ch == "\r" or ch == "\t" {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let cur = if (value_prop is String) then value_prop else (if value_prop != none then (value_prop.get() + "") else "")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let next_val = cur + ch
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if not (value_prop is String) and value_prop != none {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    hooks_mod.signal_set_value(value_prop, next_val)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if props.has("on_change") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    (props["on_change"])(next_val)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let on_bs_handler = fn () {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let cur = if (value_prop is String) then value_prop else (if value_prop != none then (value_prop.get() + "") else "")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if cur.len() > 0 {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let next_val = if cur.len() <= 1 then "" else cur.slice(0, cur.len() - 1)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if not (value_prop is String) and value_prop != none {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                hooks_mod.signal_set_value(value_prop, next_val)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if props.has("on_change") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                (props["on_change"])(next_val)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let on_submit_handler = fn () {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let cur = if (value_prop is String) then value_prop else (if value_prop != none then (value_prop.get() + "") else "")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if props.has("on_submit") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            (props["on_submit"])(cur)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let display_text = if cur_str.len() > 0 then cur_str else placeholder
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let display_color = if cur_str.len() > 0 then color_mod.text else color_mod.overlay_0

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let label_node = elements_mod.make_label(display_text, {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "font_size": font_size,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "color": display_color
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        })

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "text_input",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": width_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "height": height_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "background": bg,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_width": border_width,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_color": border_color,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_radius": 6.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "padding_x": 10.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "focusable": true,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "on_char": on_char_handler,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "on_backspace": on_bs_handler,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "on_submit": on_submit_handler
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        [label_node]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # Number input with direct numeric entry and stepper [-] / [+] buttons
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                fn make_number_input(props: Dict = {}) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let value_prop = if props.has("value") then props["value"] else 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let step = if props.has("step") then (props["step"] + 0.0) else 1.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let min_val = if props.has("min") then props["min"] else none
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let max_val = if props.has("max") then props["max"] else none
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let width_val = if props.has("width") then props["width"] else "100%"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let height_val = if props.has("height") then props["height"] else 32.0

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let cur_num = if (value_prop is Float or value_prop is Int) then (value_prop + 0.0) else (value_prop.get() + 0.0)

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let update_num = fn (new_num) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                var clamped = new_num
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if min_val != none and clamped < (min_val + 0.0) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    clamped = min_val + 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if max_val != none and clamped > (max_val + 0.0) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    clamped = max_val + 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if not (value_prop is Float or value_prop is Int) and value_prop != none {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    hooks_mod.signal_set_value(value_prop, clamped)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if props.has("on_change") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    (props["on_change"])(clamped)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let on_dec = fn (e) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let cur = if (value_prop is Float or value_prop is Int) then (value_prop + 0.0) else (value_prop.get() + 0.0)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        update_num(cur - step)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let on_inc = fn (e) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let cur = if (value_prop is Float or value_prop is Int) then (value_prop + 0.0) else (value_prop.get() + 0.0)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                update_num(cur + step)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let num_str = f"{cur_num}"

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let dec_btn = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "tag": "num_dec_btn",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "justify_content": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "width": 26.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "height": height_val - 4.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "background": color_mod.surface_1,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "border_radius": 4.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "on_click": on_dec
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                [elements_mod.make_label("-", { "font_size": 14.0, "color": color_mod.text, "font_weight": "bold" })]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            )

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let val_label = elements_mod.make_label(num_str, {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "font_size": 13.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "color": color_mod.text
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                })

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let val_container = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "tag": "num_value",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "justify_content": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "width": "flex",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "height": "100%"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                [val_label]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            )

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let inc_btn = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "tag": "num_inc_btn",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "justify_content": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "width": 26.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "height": height_val - 4.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "background": color_mod.surface_1,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "border_radius": 4.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "on_click": on_inc
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                [elements_mod.make_label("+", { "font_size": 14.0, "color": color_mod.text, "font_weight": "bold" })]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            )

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "tag": "number_input",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "width": width_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "height": height_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "background": color_mod.mantle,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "border_width": 1.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "border_color": color_mod.surface_1,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "border_radius": 6.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "padding": 2.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "gap": 4.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                [dec_btn, val_container, inc_btn]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        # High-precision Blender-style Numeric Scrubber with horizontal drag, modifier keys, and gauge fill
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        fn make_scrubber_input(props: Dict = {}) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let label_text = if props.has("label") then props["label"] else ""
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let label_color = if props.has("label_color") then props["label_color"] else color_mod.overlay_0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let value_prop = if props.has("value") then props["value"] else 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let step = if props.has("step") then (props["step"] + 0.0) else 1.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let min_val = if props.has("min") then props["min"] else none
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let max_val = if props.has("max") then props["max"] else none
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let width_val = if props.has("width") then props["width"] else (if props.has("flex") then "flex" else "100%")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let height_val = if props.has("height") then (props["height"] + 0.0) else 28.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let precision = if props.has("precision") then props["precision"] else 1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let bg = if props.has("background") then props["background"] else color_mod.mantle
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let border_color = if props.has("border_color") then props["border_color"] else color_mod.surface_1

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let cur_num = if (value_prop is Float or value_prop is Int) then (value_prop + 0.0) else (value_prop.get() + 0.0)

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let update_num = fn (new_num) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        var clamped = new_num
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if min_val != none and clamped < (min_val + 0.0) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            clamped = min_val + 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if max_val != none and clamped > (max_val + 0.0) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            clamped = max_val + 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if not (value_prop is Float or value_prop is Int) and value_prop != none {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            hooks_mod.signal_set_value(value_prop, clamped)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if props.has("on_change") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            (props["on_change"])(clamped)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # Drag handler: scrubs continuously
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let on_drag_handler = fn (e) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let dx = e["dx"] + 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if dx == 0.0 {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        var mult = 1.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if e.has("shift") and e["shift"] {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            mult = 0.1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        } elif e.has("ctrl") and e["ctrl"] {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            mult = 10.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let cur = if (value_prop is Float or value_prop is Int) then (value_prop + 0.0) else (value_prop.get() + 0.0)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let delta = dx * (step * 0.2) * mult
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let next_val = cur + delta
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                update_num(next_val)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            # Format number display: round to precision
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            var val_display = f"{cur_num}"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if precision == 0 {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                val_display = f"{Int(cur_num)}"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            } else {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let factor = 10.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let rounded = (Int(cur_num * factor + (if cur_num >= 0.0 then 0.5 else - 0.5)) + 0.0) / factor
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        val_display = f"{rounded}"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    var content_items = []

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # Optional label badge (e.g. "X", "Y", "Z" with colored tag)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if label_text != "" {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let badge_item = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "tag": "scrubber_label_badge",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "justify_content": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "width": 18.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "height": height_val - 4.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "background": color_mod.surface_0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "border_radius": 3.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            [elements_mod.make_label(label_text, { "font_size": 11.0, "color": label_color, "font_weight": "bold" })]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        content_items.add(badge_item)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # Center value label
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let val_label = elements_mod.make_label(val_display, {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "font_size": 12.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "color": color_mod.text
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        })

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let val_container = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "scrubber_value_container",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "justify_content": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": "flex",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "height": "100%"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        [val_label]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    content_items.add(val_container)

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "scrubber_input",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": width_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "height": height_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "background": bg,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_width": 1.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_color": border_color,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_radius": 5.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "padding_x": 4.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "gap": 4.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "on_drag": on_drag_handler
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        content_items
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # Dropdown selector for picking from a list of options with floating overlay menu
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                fn make_dropdown_select(props: Dict = {}) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let options = if props.has("options") then props["options"] else ["Default"]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let selected_prop = if props.has("selected") then props["selected"] else (if options.len() > 0 then options[0] else "")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let width_val = if props.has("width") then props["width"] else "100%"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let height_val = if props.has("height") then props["height"] else 32.0

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let cur_selected = if (selected_prop is String) then selected_prop else (selected_prop.get() + "")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let cycle_mode = if props.has("cycle") then props["cycle"] else false

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let on_toggle_select = fn (e) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if cycle_mode {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if options.len() <= 1 {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        return
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let cur = if (selected_prop is String) then selected_prop else (selected_prop.get() + "")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            var next_idx = 0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            var i = 0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            while i < options.len() {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if options[i] == cur {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    next_idx = (i + 1) % options.len()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                i += 1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let next_val = options[next_idx]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if not (selected_prop is String) and selected_prop != none {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                hooks_mod.signal_set_value(selected_prop, next_val)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if props.has("on_select") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                (props["on_select"])(next_val)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if overlay_mod.overlay_has_overlays() {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            overlay_mod.overlay_clear()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let r = if (e is Dict and e.has("rect") and e["rect"] != none) then e["rect"] else { "x": 0.0, "y": 0.0, "width": 150.0, "height": 32.0 }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let item_h = 28.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let menu_h = (options.len() + 0.0) * item_h + 8.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let menu_w = if r["width"] > 140.0 then r["width"] else 150.0

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                var option_items = []
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                each opt in options {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let opt_val = opt
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let is_cur = (opt_val == cur_selected)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let item_bg = if is_cur then color_mod.surface_1 else color_mod.base
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let item_btn = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "tag": "dropdown_item",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "width": "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "height": item_h,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "background": item_bg,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "padding_x": 10.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "border_radius": 4.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "on_click": fn (_) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if not (selected_prop is String) and selected_prop != none {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            hooks_mod.signal_set_value(selected_prop, opt_val)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if props.has("on_select") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            (props["on_select"])(opt_val)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        overlay_mod.overlay_pop()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                [
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                elements_mod.make_label(opt_val, {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "font_size": 12.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "color": if is_cur then color_mod.blue else color_mod.text
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        })
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    option_items.add(item_btn)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let menu_elem = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "tag": "dropdown_menu",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "width": menu_w,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "height": menu_h,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "background": color_mod.base,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "border_width": 1.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "border_color": color_mod.surface_1,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "border_radius": 6.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "padding": 4.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "gap": 2.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    option_items
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                menu_elem.layout = types_mod.types_make_rect(r["x"], r["y"] + r["height"] + 4.0, menu_w, menu_h)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                leona_mod.layout_node(menu_elem, menu_elem.layout.x, menu_elem.layout.y, menu_w, menu_h)

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                overlay_mod.overlay_push(menu_elem, { "dismissible": true })
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "tag": "dropdown_select",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "justify_content": "start",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "width": width_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "height": height_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "background": color_mod.mantle,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "border_width": 1.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "border_color": color_mod.surface_1,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "border_radius": 6.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "padding_x": 10.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "gap": 8.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "on_click": on_toggle_select
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                [
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                elements_mod.make_label(cur_selected, {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "font_size": 13.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "color": color_mod.text
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }),
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                elements_mod.make_rect({ "tag": "spacer", "width": "flex", "height": "100%" }, []),
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                elements_mod.make_label("v", {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "font_size": 10.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "color": color_mod.overlay_0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                })
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        # Color swatch picker cycling or selecting Catppuccin palette colors
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        fn make_color_picker(props: Dict = {}) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let color_prop = if props.has("color") then props["color"] else color_mod.blue
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let width_val = if props.has("width") then props["width"] else "100%"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let height_val = if props.has("height") then props["height"] else 32.0

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let palette = [
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        color_mod.blue,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        color_mod.green,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        color_mod.red,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        color_mod.peach,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        color_mod.yellow,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        color_mod.lavender,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        color_mod.white
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    ]

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let is_sig = hooks_mod.is_signal(color_prop)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let cur_color = if is_sig then color_prop.get() else color_prop

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let on_pick_next = fn (e) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let is_s = hooks_mod.is_signal(color_prop)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let cur = if is_s then color_prop.get() else color_prop
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        var next_idx = 0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        var i = 0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        while i < palette.len() {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let p = palette[i]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if p.r == cur.r and p.g == cur.g and p.b == cur.b {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                next_idx = (i + 1) % palette.len()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            i += 1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let next_c = palette[next_idx]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if is_s {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            hooks_mod.signal_set_value(color_prop, next_c)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if props.has("on_change") {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            (props["on_change"])(next_c)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let swatch = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "color_swatch",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": 18.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "height": 18.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "background": cur_color,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_width": 1.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_color": color_mod.surface_2,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_radius": 4.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        []
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let hex_label = elements_mod.make_label("Color", {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "font_size": 12.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "color": color_mod.text
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        })

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "color_picker",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": width_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "height": height_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "background": color_mod.mantle,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_width": 1.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_color": color_mod.surface_1,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_radius": 6.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "padding_x": 10.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "gap": 8.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "on_click": on_pick_next
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        [
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        swatch,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        hex_label,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        elements_mod.make_rect({ "tag": "spacer", "width": "flex", "height": "100%" }, [])
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # Modal Dialog Box with dark scrim backdrop and confirmation actions
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                fn make_dialog(title: String, content_children: List, on_confirm = none, on_cancel = none, props: Dict = {}) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let width_val = if props.has("width") then (props["width"] + 0.0) else 400.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let height_val = if props.has("height") then (props["height"] + 0.0) else 240.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # M13: labels resolve through the runtime string table instead of being
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    # hardcoded in one language.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let confirm_text = if props.has("confirm_text") then props["confirm_text"] else strings_mod.strings_get("dialog.confirm")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let cancel_text = if props.has("cancel_text") then props["cancel_text"] else strings_mod.strings_get("dialog.cancel")

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let sw = host_screen_width()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let sh = host_screen_height()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let dx = (sw - width_val) / 2.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let dy = (sh - height_val) / 2.0

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let header_row = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "dialog_header",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "height": 38.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "padding_x": 16.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "background": color_mod.mantle,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_radius": 8.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        [
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        elements_mod.make_label(title, { "font_size": 15.0, "color": color_mod.text, "font_weight": "bold" }),
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        elements_mod.make_rect({ "tag": "spacer", "width": "flex", "height": "100%" }, []),
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "dialog_close",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "justify_content": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": 24.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "height": 24.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_radius": 4.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "on_click": fn (_) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                overlay_mod.overlay_pop()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if on_cancel != none {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    (on_cancel)()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        [elements_mod.make_label("X", { "font_size": 12.0, "color": color_mod.overlay_0 })]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let actions_row = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "dialog_actions",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "justify_content": "end",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "gap": 10.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "padding_x": 16.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "padding_y": 12.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        [
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        make_button(cancel_text, fn (_) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            overlay_mod.overlay_pop()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if on_cancel != none {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                (on_cancel)()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }, { "variant": "secondary", "height": 32.0 }),
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        make_button(confirm_text, fn (_) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            overlay_mod.overlay_pop()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if on_confirm != none {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                (on_confirm)()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }, { "variant": "primary", "height": 32.0 })
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    var dialog_children = [header_row]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    each c in content_children {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        dialog_children.add(c)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    dialog_children.add(elements_mod.make_rect({ "tag": "spacer", "width": "flex", "height": "flex" }, []))
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    dialog_children.add(actions_row)

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let dialog_card = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "dialog_card",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": width_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "height": height_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "background": color_mod.base,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_width": 1.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_color": color_mod.surface_1,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "border_radius": 10.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        dialog_children
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    dialog_card.layout = types_mod.types_make_rect(dx, dy, width_val, height_val)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    leona_mod.layout_node(dialog_card, dx, dy, width_val, height_val)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return dialog_card
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # Tree view row builder helper
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                fn build_tree_nodes(nodes: List, selected_id: String, on_select, expanded_map: Dict, level: Int, indent_step: Float, item_height: Float, out_rows: List) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    each node in nodes {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if not (node is Dict) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            continue
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let nid = if node.has("id") then node["id"] else ""
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let nlabel = if node.has("label") then node["label"] else nid
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let has_kids = node.has("children") and (node["children"] is List) and node["children"].len() > 0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let is_exp = if expanded_map.has(nid) then expanded_map[nid] else (if node.has("expanded") then node["expanded"] else false)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let is_sel = (nid == selected_id)

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let indent_px = (level + 0.0) * indent_step
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let bg_color = if is_sel then color_mod.surface_1 else color_mod.base
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                let text_color = if is_sel then color_mod.blue else color_mod.text

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let chevron_text = if has_kids then (if is_exp then "v " else "> ") else "  "

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let row_elem = elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "tag": "tree_node",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "direction": "row",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "align_items": "center",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "width": "100%",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "height": item_height,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "background": bg_color,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "padding_x": 8.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "border_radius": 4.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "on_click": fn (_) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if has_kids {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        expanded_map[nid] = not is_exp
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if on_select != none {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        (on_select)(nid)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            [
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            elements_mod.make_rect({ "tag": "tree_indent", "width": indent_px, "height": 1.0 }, []),
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            elements_mod.make_label(chevron_text, { "font_size": 11.0, "color": color_mod.overlay_0 }),
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            elements_mod.make_label(nlabel, { "font_size": 13.0, "color": text_color, "font_weight": if is_sel then "bold" else "normal" })
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        out_rows.add(row_elem)

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if has_kids and is_exp {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            build_tree_nodes(node["children"], selected_id, on_select, expanded_map, level + 1, indent_step, item_height, out_rows)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # Hierarchical Tree View Component
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                fn make_tree_view(props: Dict) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let nodes = if props.has("nodes") then props["nodes"] else []
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let selected_prop = if props.has("selected") then props["selected"] else ""
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let is_sig = hooks_mod.is_signal(selected_prop)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let cur_selected = if is_sig then (selected_prop.get() + "") else (selected_prop + "")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let indent_step = if props.has("indent_step") then (props["indent_step"] + 0.0) else 14.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let item_height = if props.has("item_height") then (props["item_height"] + 0.0) else 26.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let width_val = if props.has("width") then props["width"] else "100%"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let height_val = if props.has("height") then props["height"] else "auto"

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let expanded_map = if props.has("expanded_map") then props["expanded_map"] else {}

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let on_select_user = if props.has("on_select") then props["on_select"] else none
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let on_select = fn (nid) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if is_sig {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            hooks_mod.signal_set_value(selected_prop, nid)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if on_select_user != none {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            (on_select_user)(nid)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    var row_elements = []
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    build_tree_nodes(nodes, cur_selected, on_select, expanded_map, 0, indent_step, item_height, row_elements)

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "tree_view",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": width_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "height": height_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "background": color_mod.base,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "gap": 1.0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "padding": 4.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        row_elements
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # High-performance windowed virtual list for large datasets (O(viewport) rendering)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                fn make_virtual_list(props: Dict) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let total_items = if props.has("item_count") then props["item_count"] else 0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let item_height = if props.has("item_height") then (props["item_height"] + 0.0) else 32.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let render_item_fn = if props.has("render_item") then props["render_item"] else none
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let scroll_prop = if props.has("scroll") then props["scroll"] else 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let is_sig = hooks_mod.is_signal(scroll_prop)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let cur_scroll = if is_sig then (scroll_prop.get() + 0.0) else (scroll_prop + 0.0)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let viewport_h = if props.has("height") and (props["height"] is Float or props["height"] is Int) then (props["height"] + 0.0) else 300.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let width_val = if props.has("width") then props["width"] else "100%"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let overscan = if props.has("overscan") then props["overscan"] else 2

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    var start_idx = Int(cur_scroll / item_height) - overscan
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if start_idx < 0 { start_idx = 0 }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    var visible_count = Int(viewport_h / item_height) + 1 + overscan * 2
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    var end_idx = start_idx + visible_count
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if end_idx >= total_items { end_idx = total_items - 1 }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    var items = []
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let top_spacer_h = (start_idx + 0.0) * item_height
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if top_spacer_h > 0.0 {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        items.add(elements_mod.make_rect({ "tag": "vlist_spacer_top", "width": "100%", "height": top_spacer_h }, []))
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if render_item_fn != none and total_items > 0 and start_idx <= end_idx {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        var idx = start_idx
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        while idx <= end_idx {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let row = (render_item_fn)(idx)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if row != none {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                items.add(row)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            idx += 1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let bottom_count = if total_items > 0 then (total_items - 1 - end_idx) else 0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let bottom_spacer_h = if bottom_count > 0 then ((bottom_count + 0.0) * item_height) else 0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if bottom_spacer_h > 0.0 {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        items.add(elements_mod.make_rect({ "tag": "vlist_spacer_bottom", "width": "100%", "height": bottom_spacer_h }, []))
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return elements_mod.make_rect(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "tag": "virtual_list",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "direction": "column",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "width": width_val,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "height": viewport_h,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "clip": true,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "background": color_mod.mantle
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        items
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                # Pill-shaped segmented control group with elevated active item
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                fn make_segmented_group(options: List, selected, on_change = none, props: Dict = {}) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let width_val = if props.has("width") then props["width"] else "auto"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let height_val = if props.has("height") then (props["height"] + 0.0) else 28.0
