# retro3d.aipo — Lightweight Complete 3D Engine Subsystem for aipo.zoe
# Provides:
# - Vector3 math (add, sub, scale, dot, cross, length, normalize)
# - Orbit Camera3D with pinhole perspective projection
# - Mesh primitives (Cube, Pyramid, Platform, Custom meshes)
# - Flat-shaded solid polygon rasterization with directional lighting
# - Backface culling and Painter's algorithm depth sorting
# - Perspective 3D ground plane grid
# - 3D Transformation Gizmo (X: Peach/Red, Y: Green, Z: Blue, Center) with hit-testing

import color as color_mod

# --- 1. Vector3 Math ---

fn r3d_vec3(x: Float, y: Float, z: Float) -> Dict { return {
        "x": x + 0.0,
        "y": y + 0.0,
        "z": z + 0.0
    }
}

fn r3d_vec3_add(a: Dict, b: Dict) -> Dict {
    return r3d_vec3(a["x"] + b["x"], a["y"] + b["y"], a["z"] + b["z"])
}

fn r3d_vec3_sub(a: Dict, b: Dict) -> Dict {
    return r3d_vec3(a["x"] - b["x"], a["y"] - b["y"], a["z"] - b["z"])
}

fn r3d_vec3_scale(v: Dict, s: Float) -> Dict {
    return r3d_vec3(v["x"] * s, v["y"] * s, v["z"] * s)
}

fn r3d_vec3_dot(a: Dict, b: Dict) -> Float {
    return (a["x"] + 0.0) * (b["x"] + 0.0) + (a["y"] + 0.0) * (b["y"] + 0.0) + (a["z"] + 0.0) * (b["z"] + 0.0)
}

fn r3d_vec3_cross(a: Dict, b: Dict) -> Dict {
    return r3d_vec3(
        a["y"] * b["z"] - a["z"] * b["y"],
        a["z"] * b["x"] - a["x"] * b["z"],
        a["x"] * b["y"] - a["y"] * b["x"]
    )
}

fn r3d_vec3_length(v: Dict) -> Float {
    return math.sqrt(r3d_vec3_dot(v, v))
}

fn r3d_vec3_normalize(v: Dict) -> Dict {
    let len = r3d_vec3_length(v)
    if len < 0.0001 {
        return r3d_vec3(0.0, 1.0, 0.0)
    }
    return r3d_vec3_scale(v, 1.0 / len)
}

# --- 2. Trigonometry & Rotation ---
#
# M13: sin/cos/sqrt/atan2 now delegate to the Aipo standard library, which
# computes them in f64. The previous 3-term Taylor polynomial reached 4.22%
# relative error at cos(0.6) -- the default orbit-camera yaw -- which visibly
# distorted the 3D projection. See ADP-018.

# Rotates a 3D point by yaw (around Y axis) and pitch (around X axis)
fn r3d_rotate_point(p: Dict, yaw: Float, pitch: Float) -> Dict {
    let cy = math.cos(yaw)
    let sy = math.sin(yaw)
    let cp = math.cos(pitch)
    let sp = math.sin(pitch)

    # 1. Rotate around Y axis (yaw)
    let x1 = p["x"] * cy + p["z"] * sy
    let y1 = p["y"]
    let z1 = -p["x"] * sy + p["z"] * cy

    # 2. Rotate around X axis (pitch)
    let x2 = x1
    let y2 = y1 * cp - z1 * sp
    let z2 = y1 * sp + z1 * cp

    return r3d_vec3(x2, y2, z2)
}

# --- 3. Camera3D & Projection ---

fn r3d_create_camera(yaw: Float = 0.6, pitch: Float = 0.45, distance: Float = 220.0, tx: Float = 0.0, ty: Float = 0.0, tz: Float = 0.0, fov: Float = 360.0) -> Dict {
    return {
        "yaw": yaw + 0.0,
        "pitch": pitch + 0.0,
        "dist": distance + 0.0,
        "tx": tx + 0.0,
        "ty": ty + 0.0,
        "tz": tz + 0.0,
        "fov": fov + 0.0
    }
}

# Projects a 3D point (wx, wy, wz) into 2D screen coordinates within viewport rect
# Returns { "x": sx, "y": sy, "depth": cam_z, "visible": Bool }
fn r3d_project_3d(wx: Float, wy: Float, wz: Float, cam: Dict, rect: Dict) -> Dict {
    let cyaw = math.cos(cam["yaw"])
    let syaw = math.sin(cam["yaw"])
    let cpitch = math.cos(cam["pitch"])
    let spitch = math.sin(cam["pitch"])

    # 1. Camera eye position in world space
    let eye_x = cam["tx"] + cam["dist"] * cyaw * cpitch
    let eye_y = cam["ty"] + cam["dist"] * spitch
    let eye_z = cam["tz"] + cam["dist"] * syaw * cpitch

    # 2. Translate point relative to camera eye
    let dx = wx - eye_x
    let dy = wy - eye_y
    let dz = wz - eye_z

    # 3. Rotate into camera view space
    let rx = dx * syaw - dz * cyaw
    let rz = dx * cyaw + dz * syaw
    let ry = dy

    let cam_x = rx
    let cam_y = ry * cpitch - rz * spitch
    let cam_z = -(ry * spitch + rz * cpitch)

    # 4. Near plane clipping (points behind or too close to camera)
    if cam_z <= 2.0 {
        return { "x": 0.0, "y": 0.0, "depth": cam_z, "visible": false }
    }

    # 5. Pinhole perspective projection onto screen
    let factor = cam["fov"] / cam_z
    let center_x = rect["x"] + rect["width"] / 2.0
    let center_y = rect["y"] + rect["height"] / 2.0

    let sx = center_x + cam_x * factor
    let sy = center_y - cam_y * factor

    return {
        "x": sx,
        "y": sy,
        "depth": cam_z,
        "visible": true
    }
}

# --- 4. 3D Mesh Primitives ---

fn r3d_create_cube(sx: Float, sy: Float, sz: Float, color_val = none) -> Dict {
    let c = if color_val != none then color_val else color_mod.blue
            let hx = sx / 2.0
            let hy = sy / 2.0
            let hz = sz / 2.0

            let vertices = [
                r3d_vec3(-hx, -hy, -hz), # 0
                r3d_vec3(hx, -hy, -hz), # 1
                r3d_vec3(hx, hy, -hz), # 2
                r3d_vec3(-hx, hy, -hz), # 3
                r3d_vec3(-hx, -hy, hz), # 4
                r3d_vec3(hx, -hy, hz), # 5
                r3d_vec3(hx, hy, hz), # 6
                r3d_vec3(-hx, hy, hz) # 7
            ]

            # 12 Triangles (2 per cube face) with face normals
            let triangles = [
                # Front face (+Z)
                { "i0": 4, "i1": 5, "i2": 6, "normal": r3d_vec3(0.0, 0.0, 1.0), "color": c },
                { "i0": 4, "i1": 6, "i2": 7, "normal": r3d_vec3(0.0, 0.0, 1.0), "color": c },
                # Back face (-Z)
                { "i0": 1, "i1": 0, "i2": 3, "normal": r3d_vec3(0.0, 0.0, -1.0), "color": c },
                { "i0": 1, "i1": 3, "i2": 2, "normal": r3d_vec3(0.0, 0.0, -1.0), "color": c },
                # Top face (+Y)
                { "i0": 3, "i1": 2, "i2": 6, "normal": r3d_vec3(0.0, 1.0, 0.0), "color": c },
                { "i0": 3, "i1": 6, "i2": 7, "normal": r3d_vec3(0.0, 1.0, 0.0), "color": c },
                # Bottom face (-Y)
                { "i0": 0, "i1": 1, "i2": 5, "normal": r3d_vec3(0.0, -1.0, 0.0), "color": c },
                { "i0": 0, "i1": 5, "i2": 4, "normal": r3d_vec3(0.0, -1.0, 0.0), "color": c },
                # Right face (+X)
                { "i0": 5, "i1": 1, "i2": 2, "normal": r3d_vec3(1.0, 0.0, 0.0), "color": c },
                { "i0": 5, "i1": 2, "i2": 6, "normal": r3d_vec3(1.0, 0.0, 0.0), "color": c },
                # Left face (-X)
                { "i0": 0, "i1": 4, "i2": 7, "normal": r3d_vec3(-1.0, 0.0, 0.0), "color": c },
                { "i0": 0, "i1": 7, "i2": 3, "normal": r3d_vec3(-1.0, 0.0, 0.0), "color": c }
            ]

            return {
                "vertices": vertices,
                "triangles": triangles,
                "color": c
            }
        }

        fn r3d_create_pyramid(base_size: Float, height: Float, color_val = none) -> Dict {
            let c = if color_val != none then color_val else color_mod.yellow
                    let half = base_size / 2.0
                    let hh = height / 2.0

                    let vertices = [
                        r3d_vec3(-half, -hh, -half), # 0
                        r3d_vec3(half, -hh, -half), # 1
                        r3d_vec3(half, -hh, half), # 2
                        r3d_vec3(-half, -hh, half), # 3
                        r3d_vec3(0.0, hh, 0.0) # 4: Apex
                    ]

                    let triangles = [
                        # Base
                        { "i0": 0, "i1": 2, "i2": 1, "normal": r3d_vec3(0.0, -1.0, 0.0), "color": c },
                        { "i0": 0, "i1": 3, "i2": 2, "normal": r3d_vec3(0.0, -1.0, 0.0), "color": c },
                        # 4 Sides
                        { "i0": 0, "i1": 1, "i2": 4, "normal": r3d_vec3(0.0, 0.7, -0.7), "color": c },
                        { "i0": 1, "i1": 2, "i2": 4, "normal": r3d_vec3(0.7, 0.7, 0.0), "color": c },
                        { "i0": 2, "i1": 3, "i2": 4, "normal": r3d_vec3(0.0, 0.7, 0.7), "color": c },
                        { "i0": 3, "i1": 0, "i2": 4, "normal": r3d_vec3(-0.7, 0.7, 0.0), "color": c }
                    ]

                    return {
                        "vertices": vertices,
                        "triangles": triangles,
                        "color": c
                    }
                }

                # --- 5. 3D Scene Rendering (Grid, Solid Shading, Wireframe) ---

                # Renders the 3D ground grid converging to the horizon
                fn r3d_draw_grid(cam: Dict, rect: Dict, grid_extent: Float = 200.0, cell_size: Float = 40.0) {
                    var x = -grid_extent
                    while x <= grid_extent {
                        let p1 = r3d_project_3d(x, 0.0, -grid_extent, cam, rect)
                        let p2 = r3d_project_3d(x, 0.0, grid_extent, cam, rect)
                        if p1["visible"] and p2["visible"] {
                            let line_color_r = if x == 0.0 then 0.9 else 0.25
                                    let line_color_g = if x == 0.0 then 0.5 else 0.28
                                            let line_color_b = if x == 0.0 then 0.5 else 0.38
                                                    let th = if x == 0.0 then 1.5 else 1.0
                                                            host_draw_line(p1["x"], p1["y"], p2["x"], p2["y"], th, line_color_r, line_color_g, line_color_b, 0.45)
                                                        }
                                                        x += cell_size
                                                    }

                                                    var z = -grid_extent
                                                    while z <= grid_extent {
                                                        let p1 = r3d_project_3d(-grid_extent, 0.0, z, cam, rect)
                                                        let p2 = r3d_project_3d(grid_extent, 0.0, z, cam, rect)
                                                        if p1["visible"] and p2["visible"] {
                                                            let line_color_r = if z == 0.0 then 0.4 else 0.25
                                                                    let line_color_g = if z == 0.0 then 0.6 else 0.28
                                                                            let line_color_b = if z == 0.0 then 0.9 else 0.38
                                                                                    let th = if z == 0.0 then 1.5 else 1.0
                                                                                            host_draw_line(p1["x"], p1["y"], p2["x"], p2["y"], th, line_color_r, line_color_g, line_color_b, 0.45)
                                                                                        }
                                                                                        z += cell_size
                                                                                    }
                                                                                }

                                                                                # Renders a 3D mesh with flat diffuse shading, backface culling, and Painter's algorithm
                                                                                fn r3d_render_mesh(mesh: Dict, pos: Dict, rot_yaw: Float, rot_pitch: Float, cam: Dict, rect: Dict, wireframe_only: Bool = false) {
                                                                                    let light_dir = r3d_vec3_normalize(r3d_vec3(0.5, 0.8, -0.4))
                                                                                    let vertices = mesh["vertices"]
                                                                                    let triangles = mesh["triangles"]
                                                                                    let base_color = mesh["color"]

                                                                                    # 1. Transform and project all vertices to screen
                                                                                    var projected = []
                                                                                    each v in vertices {
                                                                                        let rotated = r3d_rotate_point(v, rot_yaw, rot_pitch)
                                                                                        let world_pt = r3d_vec3_add(rotated, pos)
                                                                                        let screen_pt = r3d_project_3d(world_pt["x"], world_pt["y"], world_pt["z"], cam, rect)
                                                                                        projected.add(screen_pt)
                                                                                    }

                                                                                    # 2. Process triangles: backface culling, flat shading, depth calculation
                                                                                    var visible_tris = []
                                                                                    each tri in triangles {
                                                                                        let p0 = projected[tri["i0"]]
                                                                                        let p1 = projected[tri["i1"]]
                                                                                        let p2 = projected[tri["i2"]]

                                                                                        if p0["visible"] and p1["visible"] and p2["visible"] {
                                                                                            # 2D cross product for backface culling
                                                                                            let cross = (p1["x"] - p0["x"]) * (p2["y"] - p0["y"]) - (p1["y"] - p0["y"]) * (p2["x"] - p0["x"])
                                                                                            if cross > 0.0 or wireframe_only {
                                                                                                # Rotate normal by object rotation
                                                                                                let rotated_n = r3d_rotate_point(tri["normal"], rot_yaw, rot_pitch)
                                                                                                let dot = r3d_vec3_dot(rotated_n, light_dir)
                                                                                                let intensity = 0.35 + 0.65 * (if dot > 0.0 then dot else 0.0)

                                                                                                        let avg_depth = (p0["depth"] + p1["depth"] + p2["depth"]) / 3.0

                                                                                                        visible_tris.add({
                                                                                                                "p0": p0,
                                                                                                                "p1": p1,
                                                                                                                "p2": p2,
                                                                                                                "depth": avg_depth,
                                                                                                                "r": base_color.r * intensity,
                                                                                                                "g": base_color.g * intensity,
                                                                                                                "b": base_color.b * intensity,
                                                                                                                "a": base_color.a
                                                                                                            })
                                                                                                    }
                                                                                                }
                                                                                            }

                                                                                            # 3. Painter's algorithm: sort visible triangles back to front (highest depth to lowest)
                                                                                            var i = 0
                                                                                            while i < visible_tris.len() {
                                                                                                var j = i + 1
                                                                                                while j < visible_tris.len() {
                                                                                                    if visible_tris[j]["depth"] > visible_tris[i]["depth"] {
                                                                                                        let temp = visible_tris[i]
                                                                                                        visible_tris[i] = visible_tris[j]
                                                                                                        visible_tris[j] = temp
                                                                                                    }
                                                                                                    j += 1
                                                                                                }
                                                                                                i += 1
                                                                                            }

                                                                                            # 4. Rasterize sorted triangles
                                                                                            each item in visible_tris {
                                                                                                let p0 = item["p0"]
                                                                                                let p1 = item["p1"]
                                                                                                let p2 = item["p2"]

                                                                                                if wireframe_only {
                                                                                                    host_draw_triangle_lines(p0["x"], p0["y"], p1["x"], p1["y"], p2["x"], p2["y"], 1.5, item["r"], item["g"], item["b"], 1.0)
                                                                                                } else {
                                                                                                    host_draw_triangle(p0["x"], p0["y"], p1["x"], p1["y"], p2["x"], p2["y"], item["r"], item["g"], item["b"], item["a"])
                                                                                                    # Subtle wireframe edge outline for that crisp retro 3D aesthetic
                                                                                                    host_draw_triangle_lines(p0["x"], p0["y"], p1["x"], p1["y"], p2["x"], p2["y"], 1.0, 0.1, 0.1, 0.15, 0.4)
                                                                                                }
                                                                                            }
                                                                                        }

                                                                                        # --- 6. 3D Transformation Gizmo ---

                                                                                        # Renders a 3D translation gizmo with X (Red/Peach), Y (Green), and Z (Blue) axes
                                                                                        fn r3d_draw_gizmo(pos: Dict, cam: Dict, rect: Dict, axis_len: Float = 40.0, active_axis: String = "none") {
                                                                                            let p_center = r3d_project_3d(pos["x"], pos["y"], pos["z"], cam, rect)
                                                                                            let p_x = r3d_project_3d(pos["x"] + axis_len, pos["y"], pos["z"], cam, rect)
                                                                                            let p_y = r3d_project_3d(pos["x"], pos["y"] + axis_len, pos["z"], cam, rect)
                                                                                            let p_z = r3d_project_3d(pos["x"], pos["y"], pos["z"] + axis_len, cam, rect)

                                                                                            if not p_center["visible"] {
                                                                                                return
                                                                                            }

                                                                                            let cx = p_center["x"]
                                                                                            let cy = p_center["y"]

                                                                                            # X axis (Peach/Red)
                                                                                            if p_x["visible"] {
                                                                                                let is_act = (active_axis == "x")
                                                                                                let col_r = if is_act then 1.0 else 0.95
                                                                                                        let col_g = if is_act then 0.9 else 0.45
                                                                                                                let col_b = if is_act then 0.4 else 0.45
                                                                                                                        let th = if is_act then 3.0 else 2.0
                                                                                                                                host_draw_line(cx, cy, p_x["x"], p_x["y"], th, col_r, col_g, col_b, 1.0)
                                                                                                                                host_draw_rect(p_x["x"] - 3.0, p_x["y"] - 3.0, 6.0, 6.0, col_r, col_g, col_b, 1.0)
                                                                                                                                host_draw_text("X", p_x["x"] + 6.0, p_x["y"] - 3.0, 11.0, col_r, col_g, col_b)
                                                                                                                            }

                                                                                                                            # Y axis (Green)
                                                                                                                            if p_y["visible"] {
                                                                                                                                let is_act = (active_axis == "y")
                                                                                                                                let col_r = if is_act then 0.6 else 0.4
                                                                                                                                        let col_g = if is_act then 1.0 else 0.85
                                                                                                                                                let col_b = if is_act then 0.6 else 0.4
                                                                                                                                                        let th = if is_act then 3.0 else 2.0
                                                                                                                                                                host_draw_line(cx, cy, p_y["x"], p_y["y"], th, col_r, col_g, col_b, 1.0)
                                                                                                                                                                host_draw_rect(p_y["x"] - 3.0, p_y["y"] - 3.0, 6.0, 6.0, col_r, col_g, col_b, 1.0)
                                                                                                                                                                host_draw_text("Y", p_y["x"] - 3.0, p_y["y"] - 14.0, 11.0, col_r, col_g, col_b)
                                                                                                                                                            }

                                                                                                                                                            # Z axis (Blue)
                                                                                                                                                            if p_z["visible"] {
                                                                                                                                                                let is_act = (active_axis == "z")
                                                                                                                                                                let col_r = if is_act then 0.6 else 0.45
                                                                                                                                                                        let col_g = if is_act then 0.8 else 0.6
                                                                                                                                                                                let col_b = if is_act then 1.0 else 0.95
                                                                                                                                                                                        let th = if is_act then 3.0 else 2.0
                                                                                                                                                                                                host_draw_line(cx, cy, p_z["x"], p_z["y"], th, col_r, col_g, col_b, 1.0)
                                                                                                                                                                                                host_draw_rect(p_z["x"] - 3.0, p_z["y"] - 3.0, 6.0, 6.0, col_r, col_g, col_b, 1.0)
                                                                                                                                                                                                host_draw_text("Z", p_z["x"] + 6.0, p_z["y"] + 4.0, 11.0, col_r, col_g, col_b)
                                                                                                                                                                                            }

                                                                                                                                                                                            # Center handle (White / Lavender)
                                                                                                                                                                                            let is_c = (active_axis == "center")
                                                                                                                                                                                            let c_r = if is_c then 1.0 else 0.8
                                                                                                                                                                                                    let c_g = if is_c then 1.0 else 0.85
                                                                                                                                                                                                            let c_b = if is_c then 0.4 else 0.95
                                                                                                                                                                                                                    host_draw_rect(cx - 5.0, cy - 5.0, 10.0, 10.0, c_r, c_g, c_b, 1.0)
                                                                                                                                                                                                                    host_draw_rect_lines(cx - 5.0, cy - 5.0, 10.0, 10.0, 1.0, 0.1, 0.1, 0.15, 0.9)
                                                                                                                                                                                                                }

                                                                                                                                                                                                                # Distance between point (px, py) and line segment (x1, y1) to (x2, y2)
                                                                                                                                                                                                                fn dist_to_segment(px: Float, py: Float, x1: Float, y1: Float, x2: Float, y2: Float) -> Float {
                                                                                                                                                                                                                    let l2 = (x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1)
                                                                                                                                                                                                                    if l2 < 0.001 {
                                                                                                                                                                                                                        let d = (px - x1) * (px - x1) + (py - y1) * (py - y1)
                                                                                                                                                                                                                        return math.sqrt(d)
                                                                                                                                                                                                                    }
                                                                                                                                                                                                                    var t = ((px - x1) * (x2 - x1) + (py - y1) * (y2 - y1)) / l2
                                                                                                                                                                                                                    if t < 0.0 { t = 0.0 }
                                                                                                                                                                                                                    if t > 1.0 { t = 1.0 }
                                                                                                                                                                                                                    let proj_x = x1 + t * (x2 - x1)
                                                                                                                                                                                                                    let proj_y = y1 + t * (y2 - y1)
                                                                                                                                                                                                                    let dist_sq = (px - proj_x) * (px - proj_x) + (py - proj_y) * (py - proj_y)
                                                                                                                                                                                                                    return math.sqrt(dist_sq)
                                                                                                                                                                                                                }

                                                                                                                                                                                                                # Hit-tests mouse screen point against 3D gizmo axes
                                                                                                                                                                                                                # Returns "center", "x", "y", "z", or "none"
                                                                                                                                                                                                                fn r3d_test_gizmo_hit(mx: Float, my: Float, pos: Dict, cam: Dict, rect: Dict, axis_len: Float = 40.0) -> String {
                                                                                                                                                                                                                    let p_center = r3d_project_3d(pos["x"], pos["y"], pos["z"], cam, rect)
                                                                                                                                                                                                                    if not p_center["visible"] {
                                                                                                                                                                                                                        return "none"
                                                                                                                                                                                                                    }

                                                                                                                                                                                                                    let cx = p_center["x"]
                                                                                                                                                                                                                    let cy = p_center["y"]

                                                                                                                                                                                                                    # 1. Center handle check
                                                                                                                                                                                                                    if (mx >= cx - 8.0) and (mx <= cx + 8.0) and (my >= cy - 8.0) and (my <= cy + 8.0) {
                                                                                                                                                                                                                        return "center"
                                                                                                                                                                                                                    }

                                                                                                                                                                                                                    # 2. X axis check
                                                                                                                                                                                                                    let p_x = r3d_project_3d(pos["x"] + axis_len, pos["y"], pos["z"], cam, rect)
                                                                                                                                                                                                                    if p_x["visible"] {
                                                                                                                                                                                                                        if dist_to_segment(mx, my, cx, cy, p_x["x"], p_x["y"]) <= 8.0 {
                                                                                                                                                                                                                            return "x"
                                                                                                                                                                                                                        }
                                                                                                                                                                                                                    }

                                                                                                                                                                                                                    # 3. Y axis check
                                                                                                                                                                                                                    let p_y = r3d_project_3d(pos["x"], pos["y"] + axis_len, pos["z"], cam, rect)
                                                                                                                                                                                                                    if p_y["visible"] {
                                                                                                                                                                                                                        if dist_to_segment(mx, my, cx, cy, p_y["x"], p_y["y"]) <= 8.0 {
                                                                                                                                                                                                                            return "y"
                                                                                                                                                                                                                        }
                                                                                                                                                                                                                    }

                                                                                                                                                                                                                    # 4. Z axis check
                                                                                                                                                                                                                    let p_z = r3d_project_3d(pos["x"], pos["y"], pos["z"] + axis_len, cam, rect)
                                                                                                                                                                                                                    if p_z["visible"] {
                                                                                                                                                                                                                        if dist_to_segment(mx, my, cx, cy, p_z["x"], p_z["y"]) <= 8.0 {
                                                                                                                                                                                                                            return "z"
                                                                                                                                                                                                                        }
                                                                                                                                                                                                                    }

                                                                                                                                                                                                                    return "none"
                                                                                                                                                                                                                }

                                                                                                                                                                                                                export r3d_vec3, r3d_vec3_add, r3d_vec3_sub, r3d_vec3_scale, r3d_vec3_dot, r3d_vec3_cross, r3d_vec3_length, r3d_vec3_normalize
                                                                                                                                                                                                                export dist_to_segment
                                                                                                                                                                                                                export r3d_rotate_point, r3d_create_camera, r3d_project_3d
                                                                                                                                                                                                                export r3d_create_cube, r3d_create_pyramid
                                                                                                                                                                                                                export r3d_draw_grid, r3d_render_mesh, r3d_draw_gizmo, r3d_test_gizmo_hit
