{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raillen/prumo/main/schemas/documentation-binding.schema.json",
  "type": "object",
  "required": ["contract_id", "sources", "ownership", "authority"],
  "properties": {
    "contract_id": { "type": "string" },
    "sources": { "type": "array", "items": { "type": "string" } },
    "sections": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
    "ownership": { "enum": ["human-maintained", "prumo-maintained", "generated", "external/reference"] },
    "authority": { "enum": ["locked-protocol", "accepted-adr", "canonical-documentation", "generated-reference", "external-source", "agent-proposal"] },
    "answered_questions": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "applicability": {
      "description": "Whether the project owes this contract now. Absent means applicable, so an obligation can never be waived by omission.",
      "enum": ["applicable", "not-applicable"]
    },
    "not_applicable_reason": {
      "description": "Required when applicability is not-applicable: the reason a reviewer reads instead of re-deriving why the gate went quiet.",
      "type": "string",
      "minLength": 1
    },
    "requirement_map": {
      "description": "Required-knowledge phrase to stable requirement ID. Without it a requirement is unmapped and readiness cannot pass (W15.3).",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "claims": {
      "description": "Durable claims that satisfy requirements and carry the evidence proving them (W15.3).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "status", "requires"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string" },
          "status": { "enum": ["proposed", "accepted", "superseded", "rejected"] },
          "authority": { "enum": ["locked-protocol", "accepted-adr", "canonical-documentation", "generated-reference", "external-source", "agent-proposal", "external"] },
          "revision": { "type": "integer", "minimum": 0 },
          "freshness": { "enum": ["current", "stale", "unknown"] },
          "requires": { "type": "array", "items": { "type": "string" } },
          "superseded_by": { "type": "string" },
          "contradicts": { "type": "array", "items": { "type": "string" } },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "target"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "type": "string" },
                "target": { "type": "string", "description": "Claim ID this evidence proves (W15.6)." },
                "revision": { "type": "string" },
                "producer": { "type": "string" },
                "verified": { "type": "boolean" },
                "freshness": { "enum": ["current", "stale", "unknown"] },
                "artifact": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "applicability": { "const": "not-applicable" } }, "required": ["applicability"] },
      "then": { "required": ["not_applicable_reason"] }
    }
  ],
  "additionalProperties": false
}
