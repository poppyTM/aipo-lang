{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raillen/prumo/main/schemas/viewer-extension-manifest.schema.json",
  "title": "Prumo Viewer Extension Manifest",
  "description": "Distribution and contribution contract for a Prumo Viewer extension.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "version",
    "publisher",
    "extension_api",
    "host",
    "runtime"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/namespacedId" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": { "$ref": "#/$defs/semver" },
    "publisher": { "type": "string", "minLength": 1 },
    "extension_api": { "const": "prumo.viewer.extensions/v1" },
    "host": { "$ref": "#/$defs/host" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "permissions": {
      "type": "array",
      "items": { "$ref": "#/$defs/permission" }
    },
    "contributions": { "$ref": "#/$defs/contributions" }
  },
  "$defs": {
    "namespacedId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_version", "max_version"],
      "properties": {
        "min_version": { "$ref": "#/$defs/semver" },
        "max_version": { "$ref": "#/$defs/semver" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["declarative", "process"] },
        "protocol": { "type": "string" },
        "entrypoint": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "declarative" } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["protocol"] },
                { "required": ["entrypoint"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "process" } } },
          "then": {
            "required": ["protocol", "entrypoint"],
            "properties": {
              "protocol": { "const": "json-rpc-2.0" }
            }
          }
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "since"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean", "default": true },
        "since": { "$ref": "#/$defs/semver" }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "scope", "risk", "justification"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["low", "medium", "high"] },
        "justification": { "type": "string", "minLength": 1 }
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "views": {
          "type": "array",
          "items": { "$ref": "#/$defs/view" }
        },
        "panels": {
          "type": "array",
          "items": { "$ref": "#/$defs/panel" }
        },
        "themes": {
          "type": "array",
          "items": { "$ref": "#/$defs/theme" }
        },
        "keybindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/keybinding" }
        },
        "lsp": {
          "type": "array",
          "items": { "$ref": "#/$defs/lsp" }
        },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/task" }
        },
        "debuggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/debugger" }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "action": {
          "enum": [
            "process",
            "find_in_file",
            "find_in_project",
            "toggle_sidebar",
            "toggle_agent",
            "toggle_dock",
            "open_terminal",
            "open_settings",
            "refresh_workspace",
            "new_file",
            "new_folder",
            "toggle_theme"
          ]
        },
        "keybinding": { "type": "string", "minLength": 1 }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "title": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "maxLength": 16384 }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "title": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "maxLength": 16384 }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tokens"],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "name": { "type": "string", "minLength": 1 },
        "tokens": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "keybinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "key"],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "command": { "$ref": "#/$defs/namespacedId" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "lsp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "language", "command"],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "language": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string" }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "command"],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "title": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string" }
        },
        "working_directory": { "type": "string", "minLength": 1 }
      }
    },
    "debugger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "command"],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "title": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string" }
        }
      }
    }
  }
}
