{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raillen/prumo/main/schemas/ui-component-contract.schema.json",
  "type": "object",
  "required": ["id", "name", "anatomy", "states", "tokens", "interactions"],
  "properties": {
    "id": { "type": "string", "pattern": "^ui:[a-z0-9][a-z0-9._-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "intent": { "type": "string" },
    "anatomy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["part"],
        "properties": {
          "part": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "required": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Applicable states. Not every component needs every state; applicability must be explicit."
    },
    "tokens": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Semantic token IDs consumed by this component (W9)."
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["input", "effect"],
        "properties": {
          "input": { "type": "string", "description": "Keybinding, pointer, or gesture." },
          "effect": { "type": "string" },
          "keyboard_only": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "focusable": { "type": "boolean" },
        "focus_visible": { "type": "boolean" },
        "contrast_min": { "type": "number", "minimum": 1, "maximum": 21 },
        "announcement": { "type": "string" },
        "evidence_required": { "type": "array", "items": { "enum": ["automated", "manual", "visual", "interaction", "platform-specific", "exception-with-rationale"] } }
      },
      "additionalProperties": true
    },
    "implementation": {
      "type": "object",
      "properties": {
        "symbol": { "type": "string", "description": "Code symbol implementing this component." },
        "story_or_snapshot": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
