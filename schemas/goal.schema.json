{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raillen/prumo/main/schemas/goal.schema.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "phase",
    "state",
    "objective",
    "acceptance",
    "gates",
    "dependencies",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "DRAFT",
        "PLANNED",
        "LOCKED",
        "EXECUTING",
        "VERIFYING",
        "REVIEWING",
        "BLOCKED",
        "DONE"
      ]
    },
    "lock": {
      "type": "object",
      "required": [
        "revision",
        "locked_at",
        "digest"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string"
        },
        "locked_at": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string"
          }
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gates": {
      "type": "object",
      "minProperties": 1
    },
    "context": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array"
    },
    "history": {
      "type": "array"
    }
  },
  "additionalProperties": true
}