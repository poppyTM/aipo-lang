{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raillen/prumo/main/schemas/plan.schema.json",
  "type": "object",
  "required": [
    "id",
    "version",
    "goal_id",
    "goal_revision",
    "created_at",
    "created_by",
    "status",
    "tasks"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "goal_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "goal_revision": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "created_by": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["DRAFT", "REVIEWED", "APPROVED", "SUPERSEDED", "CANCELLED"]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "$ref": "task.schema.json" }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "context_strategy": {
      "oneOf": [
        { "type": "string" },
        { "type": "object" }
      ]
    },
    "budget": { "type": "object" },
    "review": { "type": "object" },
    "approval": { "type": "object" },
    "digest": { "type": "string" }
  },
  "additionalProperties": true
}
