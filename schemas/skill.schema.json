{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raillen/prumo/main/schemas/skill.schema.json",
  "type": "object",
  "required": [
    "id",
    "name",
    "purpose"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "core": {
      "type": ["boolean", "string"]
    },
    "description": {
      "type": "string"
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "select": {
      "type": "object",
      "properties": {
        "project_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stack_any": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "features_any": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_any": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "implementation",
          "review",
          "audit",
          "research",
          "design",
          "testing",
          "documentation",
          "release"
        ]
      }
    },
    "inputs": {
      "type": "array"
    },
    "outputs": {
      "type": "array"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_any": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "framework",
            "organization",
            "project",
            "external"
          ]
        },
        "source": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "checksum": {
          "type": "string"
        },
        "modified": {
          "type": ["boolean", "string"]
        }
      },
      "additionalProperties": true
    },
    "instructions": {
      "type": "string"
    }
  },
  "additionalProperties": true
}