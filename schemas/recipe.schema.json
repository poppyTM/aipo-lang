{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raillen/prumo/main/schemas/recipe.schema.json",
  "type": "object",
  "required": ["id", "purpose", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "name": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "select": { "type": "object" },
    "requires_skills_any": { "type": "array", "items": { "type": "string" } },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "inputs": { "type": "array" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "agent_role"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "agent_role": { "type": "string", "minLength": 1 },
          "skills": { "type": "array", "items": { "type": "string" } },
          "input": { "type": "string" },
          "output": { "type": "string" },
          "required_evidence": { "type": "array", "items": { "type": "string" } },
          "gates": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "agents": { "type": "array", "items": { "type": "string" } },
    "skills": { "type": "array", "items": { "type": "string" } },
    "gates": {
      "oneOf": [
        { "type": "array", "items": { "type": "string" } },
        { "type": "object" }
      ]
    },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "fallbacks": { "type": "array" },
    "stop_conditions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
