{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raillen/prumo/main/schemas/documentation-unit.schema.json",
  "type": "object",
  "required": ["id", "kind", "intent", "audience", "authority", "generation_policy", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^docunit:[a-z0-9][a-z0-9._-]*$" },
    "kind": { "enum": ["page", "tutorial", "how-to", "reference", "explanation", "api-reference", "release-note", "agent-rule", "migration-guide"] },
    "intent": { "enum": ["tutorial", "how-to", "reference", "explanation", "release", "instruction"] },
    "audience": { "type": "array", "minItems": 1, "items": { "enum": ["user", "developer", "operator", "agent"] } },
    "surface_targets": { "type": "array", "items": { "enum": ["repository", "implementation", "reference", "agent", "site", "ai-retrieval", "api-reference", "release"] } },
    "authority": { "enum": ["canonical", "projection"] },
    "generation_policy": { "enum": ["GENERATED", "ASSISTED", "CURATED"] },
    "source_contracts": { "type": "array", "items": { "type": "string" } },
    "source_claims": { "type": "array", "items": { "type": "string" } },
    "source_symbols": { "type": "array", "items": { "type": "string" } },
    "source_schemas": { "type": "array", "items": { "type": "string" } },
    "required_evidence": { "type": "array", "items": { "type": "string" } },
    "visibility": { "enum": ["public", "project", "internal", "restricted", "confidential"] },
    "sensitivity": { "enum": ["none", "personal", "business", "secret"] },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "version": { "type": "string" },
    "status": { "enum": ["proposed", "planned", "draft", "review", "current", "needs-update", "stale", "superseded", "archived"] },
    "freshness": { "type": "object", "additionalProperties": true },
    "supersedes": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "related_units": { "type": "array", "items": { "type": "string" } },
    "projection_targets": { "type": "array", "items": { "type": "string" } },
    "quality_policy": { "type": "string" },
    "token_estimate": { "type": "integer", "minimum": 0 },
    "provenance": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
