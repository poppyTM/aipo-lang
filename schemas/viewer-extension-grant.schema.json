{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raillen/prumo/main/schemas/viewer-extension-grant.schema.json",
  "title": "Prumo Viewer Extension Grant",
  "description": "User or project authorization separate from an extension manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extension_id",
    "extension_version",
    "manifest_digest",
    "capabilities",
    "scopes"
  ],
  "properties": {
    "extension_id": { "type": "string", "minLength": 1 },
    "extension_version": { "type": "string", "minLength": 1 },
    "manifest_digest": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "scopes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "expires_at": { "type": ["string", "null"] }
  }
}
