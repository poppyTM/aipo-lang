{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raillen/prumo/main/schemas/documentation-surface.schema.json",
  "type": "object",
  "required": ["id", "kind", "visibility"],
  "properties": {
    "id": { "type": "string", "pattern": "^surface:[a-z0-9][a-z0-9._-]*$" },
    "kind": { "enum": ["human-repository", "implementation-spec", "reference", "agent-instruction", "site", "ai-index", "translation", "release", "media-index", "api-reference"] },
    "renderer": { "type": "string", "description": "Adapter name. Must be replaceable and non-canonical." },
    "locales": { "type": "array", "items": { "type": "string" } },
    "version_aware": { "type": "boolean" },
    "visibility": { "enum": ["public", "project", "internal", "restricted", "confidential"] },
    "mutation": { "enum": ["read-only", "permission-gated"] }
  },
  "additionalProperties": true
}
