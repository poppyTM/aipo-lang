{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://raw.githubusercontent.com/raillen/prumo/main/schemas/context-manifest.schema.json","type":"object","required":["version","run_id","estimated_tokens"],"properties":{"version":{"type":"integer","enum":[1,2],"description":"1 = legacy `sources` projection; 2 = Context Compiler v2 `included`/`excluded` manifest."},"id":{"type":"string","pattern":"^CTX-","description":"Canonical manifest identifier (v2)."},"created_at":{"type":"string"},"run_id":{"type":"string"},"sources":{"type":"array","description":"v1 source projection.","items":{"type":"object","required":["ref","included"],"properties":{"ref":{"type":"string"},"included":{"type":"boolean"},"authority":{"type":"string"},"freshness":{"type":"string"},"token_cost":{"type":"integer","minimum":0},"reason":{"type":"string"}},"additionalProperties":true}},"included":{"type":"array","description":"v2 included items; every item carries a selection reason.","items":{"type":"object","required":["ref","reason"],"properties":{"ref":{"type":"string"},"reason":{"type":"string","minLength":1},"authority":{"enum":["canonical","reference","imported","untrusted"]},"trust":{"enum":["high","medium","low"]},"privacy":{"enum":["public","internal","confidential","restricted"]},"freshness":{"type":"string"},"score":{"type":"number"},"method":{"type":"string"},"token_cost":{"type":"integer","minimum":0},"level":{"enum":["L0","L1","L2","L3","L4"]},"truncated":{"type":"boolean"},"projection":{"type":"boolean"},"canonical_source":{"type":"string"},"depends_on":{"type":"array","items":{"type":"string"}}},"additionalProperties":true}},"estimated_tokens":{"type":"integer","minimum":0},"level":{"enum":["L0","L1","L2","L3","L4"]},"policy":{"type":"string"},"instruction_tokens":{"type":"integer","minimum":0,"description":"Instruction/adapter overhead, reported separately from retrieved content (W4.10)."},"excluded":{"type":"array","description":"Typed exclusion reasons: budget,