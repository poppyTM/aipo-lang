{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raillen/prumo/main/schemas/model-policy.schema.json",
  "type": "object",
  "required": [
    "version",
    "selection_rule",
    "cross_provider_review",
    "roster",
    "roles"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "selection_rule": { "type": "string" },
    "cross_provider_review": { "type": ["boolean", "string"] },
    "context_aware_routing": { "type": ["boolean", "string"] },
    "roster": { "type": "array", "minItems": 1 },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["provider", "model"],
        "properties": {
          "id": { "type": "string" },
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "context_window": { "type": "integer", "minimum": 1 },
          "strengths": { "type": "array", "items": { "type": "string" } },
          "weaknesses": { "type": "array", "items": { "type": "string" } },
          "cost_class": { "enum": ["free", "low", "medium", "high", "custom"] }
        },
        "additionalProperties": true
      }
    },
    "roles": { "type": "object" },
    "quality_policy": { "type": "object" },
    "cost_policy": { "type": "object" },
    "fallback_policy": { "type": "object" }
  },
  "additionalProperties": true
}
