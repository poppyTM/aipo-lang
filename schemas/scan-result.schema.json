{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://raw.githubusercontent.com/raillen/prumo/main/schemas/scan-result.schema.json",
  "$comment":"F-G01: complete scanner output for a repository discovery pass.",
  "type":"object",
  "required":["version","root","revision","facts","budget"],
  "properties":{
    "version":{"type":"integer","const":1},
    "root":{"type":"string","minLength":1},
    "revision":{"type":"string"},
    "branch":{"type":"string"},
    "dirty":{"type":"boolean"},
    "facts":{"type":"array","items":{"$ref":"https://raw.githubusercontent.com/raillen/prumo/main/schemas/observed-fact.schema.json"}},
    "budget":{"$ref":"#/$defs/budget_status"},
    "scanned_at":{"type":"string","format":"date-time"},
    "previous_revision":{"type":"string","description":"Revision of previous scan for incremental mode"},
    "incremental":{"type":"boolean"},
    "excluded_paths":{"type":"array","items":{"type":"string"}},
    "warnings":{"type":"array","items":{"type":"string"}}
  },
  "$defs":{
    "budget_status":{
      "type":"object",
      "required":["max_files","files_scanned"],
      "properties":{
        "max_files":{"type":"integer","minimum":0},
        "max_bytes":{"type":"integer","minimum":0},
        "files_scanned":{"type":"integer","minimum":0},
        "bytes_scanned":{"type":"integer","minimum":0},
        "exhausted":{"type":"boolean"},
        "continuation":{"type":"string","description":"Opaque token for resuming a budget-limited scan"}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
