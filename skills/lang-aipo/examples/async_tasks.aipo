# Programação assíncrona, blocos sequenciais e combinadores em Aipo V1
#
# Fatos da linguagem usados aqui:
# - `task` e `io` são prelude: disponíveis sem `import`.
# - `task` expõe `spawn`, `sleep`, `all`, `race`, `timeout`, `cancel` e `group`.
#   Não existe `task.now`.
# - `await do { ... }` é **statement** (não inicializador) e o `return`
#   dentro dele retorna da função externa.
# - `task.spawn(fn, args)` recebe a lista de argumentos como segundo item.
# - Não existe `main` implícito: o topo do módulo é o script.
export buscar_dados_combinados

async fn simular_requisicao(url: String, atraso_ms: Int) -> String {
    task.sleep(atraso_ms)
    return f"resultado de {url}"
}

async fn buscar_dados_combinados() -> Dict {
    # 'await do' executa awaits sequenciais com ordem explícita: sem closure
    # e sem paralelismo implícito.
    await do {
        let perfil = await simular_requisicao("https://api/perfil", 20)
        let config = await simular_requisicao("https://api/config", 30)
        return {
            "perfil": perfil,
            "config": config
        }
    }
}

let dados = await buscar_dados_combinados()
io.println(f"Perfil carregado: {dados.perfil}")
io.println(f"Config carregada: {dados.config}")

# Combinador: `task.all` preserva a ordem em que as tarefas foram dadas.
let tarefas = [
    simular_requisicao("https://api/a", 10),
    simular_requisicao("https://api/b", 5)
]
io.println(task.all(tarefas))
